{{- if eq .osid "linux-arch" -}}
#!/usr/bin/env bash

set -euo pipefail

# run_after scripts are evaluated on every `chezmoi apply`, so installing
# Alacritty later still triggers this optional preview helper check. Avoid
# prompting for sudo unless Alacritty is present and ueberzugpp is missing.
if pacman -Qq alacritty >/dev/null 2>&1 && ! pacman -Qq ueberzugpp >/dev/null 2>&1; then
  sudo pacman -S --noconfirm --needed ueberzugpp
fi
{{- end -}}
