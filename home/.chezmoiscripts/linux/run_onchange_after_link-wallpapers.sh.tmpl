link_file() {
  local src="$1"
  local dest_dir="$2"
  local name target current
  name="$(basename "$src")"
  mkdir -p "$dest_dir"
  target="$dest_dir/$name"

  if [[ -L $target ]]; then
    current="$(readlink -f -- "$target" || true)"
    if [[ $current != "$(readlink -f -- "$src")" ]]; then
      ln -sfn "$src" "$target"
      linked=$((linked + 1))
    else
      skipped=$((skipped + 1))
    fi
  elif [[ -e $target ]]; then
    skipped=$((skipped + 1))
  else
    ln -s "$src" "$target"
    linked=$((linked + 1))
  fi
}

sources=()
[[ -d $PRODUCT_ROOT ]] && sources+=("$PRODUCT_ROOT")
[[ -d $PERSONAL_ROOT ]] && sources+=("$PERSONAL_ROOT")

if [[ ${#sources[@]} -eq 0 ]]; then
  echo "[wallpapers] no source: $PRODUCT_ROOT nor $PERSONAL_ROOT" >&2
  exit 0
fi

shopt -s nullglob
for src_root in "${sources[@]}"; do
  for theme_dir in "$src_root"/*/; do
    [[ -d $theme_dir ]] || continue
    theme_name="$(basename "$theme_dir")"
    dest="$DEST_ROOT/$theme_name"
    for src in "$theme_dir"*.{png,jpg,jpeg,webp,gif}; do
      [[ -f $src ]] || continue
      link_file "$src" "$dest"
    done
  done
done
shopt -u nullglob

echo "[wallpapers] linked=$linked skipped=$skipped legacy_removed=$legacy_removed stale_links_removed=$legacy_links_removed (sources: ${sources[*]} → $DEST_ROOT/<theme>/)"
