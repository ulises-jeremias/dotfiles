{{- if not .ephemeral -}}
#!/usr/bin/env bash

## Copyright (C) 2019-2026 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Symlinks themed + curated wallpapers into ~/Pictures/Wallpapers/<dir>/
## so Appearance / launcher wallpaper pools see them.

set -euo pipefail

SRC_ROOT="${HOME}/.local/share/dots/wallpapers"
DEST_ROOT="${HOME}/Pictures/Wallpapers"

# Trigger: re-run when any wallpaper filename set changes.
# {{- range (glob (joinPath .chezmoi.sourceDir "dot_local/share/dots/wallpapers/**/*.{png,jpg,jpeg,webp,gif}")) }}
# {{ . }}
# {{- end }}

if [[ ! -d $SRC_ROOT ]]; then
  echo "[wallpapers] source missing: $SRC_ROOT" >&2
  exit 0
fi

mkdir -p "$DEST_ROOT"

linked=0
skipped=0

link_file() {
  local src="$1"
  local dest_dir="$2"
  local name target current
  name="$(basename "$src")"
  mkdir -p "$dest_dir"
  target="$dest_dir/$name"

  if [[ -L $target ]]; then
    current="$(readlink -f -- "$target" || true)"
    if [[ $current != "$(readlink -f -- "$src")" ]]; then
      ln -sfn "$src" "$target"
      linked=$((linked + 1))
    else
      skipped=$((skipped + 1))
    fi
  elif [[ -e $target ]]; then
    skipped=$((skipped + 1))
  else
    ln -s "$src" "$target"
    linked=$((linked + 1))
  fi
}

shopt -s nullglob
for theme_dir in "$SRC_ROOT"/*/; do
  [[ -d $theme_dir ]] || continue
  theme_name="$(basename "$theme_dir")"
  dest="$DEST_ROOT/$theme_name"
  for src in "$theme_dir"*.{png,jpg,jpeg,webp,gif}; do
    [[ -f $src ]] || continue
    link_file "$src" "$dest"
  done
done
shopt -u nullglob

echo "[wallpapers] linked=$linked skipped=$skipped (source: $SRC_ROOT → $DEST_ROOT/<theme>/)"
{{- end -}}
