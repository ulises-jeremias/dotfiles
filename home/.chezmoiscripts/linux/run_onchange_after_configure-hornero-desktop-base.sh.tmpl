#!/usr/bin/env bash
# HorneroOS desktop base on a dotfiles host (contract C: product files come
# from HorneroOS repos, dotfiles only wires them in, never mirrors them).
#
# 1. Qt platform theme: seed ~/.config/qt6ct/qt6ct.conf from
#    HorneroOS/config (Papirus-Dark icons, IBM Plex fonts, Signal palette) when absent, so the
#    shell, tray and launcher resolve real icons. An existing file is the
#    user's and is left alone. Offline: skip with a warning.
# 2. Notifications: the Hornero shell owns org.freedesktop.Notifications.
#    Mask the user units of stand-alone daemons (dunst, mako, swaync) that
#    otherwise win the name through D-Bus activation (same rule as
#    HorneroOS/config scripts/materialize.sh). User-authored units are kept.
#    D-Bus-activated daemons are shadowed with user-level no-op service
#    files too. Revert: rm ~/.config/systemd/user/<daemon>.service and
#    ~/.local/share/dbus-1/services/<name>.service

# 3. User seeding: invoke packaged HorneroOS/config seed-user.sh (missing-only,
#    non-destructive) when present on the host so new accounts receive factory
#    defaults (Hornero Left layout, desktop clock, visualiser, fuzzy launcher,
#    mic OSD, fullscreen gaming auto-mode) without overwriting user files.
# 4. Resource-isolation systemd user slices: seed app-models.slice,
#    app-agents.slice, and Ollama/llama-server drop-ins from HorneroOS/config
#    when absent so local AI models and coding agents never starve the desktop.

set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HORNERO_CONFIG_RAW="https://raw.githubusercontent.com/HorneroOS/config/main"
QT6CT_URL="${HORNERO_CONFIG_RAW}/desktop/qt6ct/qt6ct.conf"

qt6ct_conf="${CONFIG_HOME}/qt6ct/qt6ct.conf"
if [[ ! -e "${qt6ct_conf}" ]]; then
    tmp="$(mktemp)"
    if curl -fsSL --max-time 20 "${QT6CT_URL}" -o "${tmp}" && grep -q '^icon_theme=' "${tmp}"; then
        mkdir -p "$(dirname "${qt6ct_conf}")"
        install -m 0644 "${tmp}" "${qt6ct_conf}"
        echo "hornero-desktop-base: seeded ${qt6ct_conf} from HorneroOS/config"
    else
        echo "hornero-desktop-base: could not fetch qt6ct defaults, skipping" >&2
    fi
    rm -f "${tmp}"
fi

# Non-destructive missing-only user seeding from packaged hornero-config.
# hornero-config >= 0.5.0 installs seed-user.sh at /usr/share/hornero/seed-user.sh
# (older packages placed it under /usr/share/hornero/scripts/seed-user.sh).
for seed_script in \
    /usr/share/hornero/seed-user.sh \
    /usr/share/hornero/scripts/seed-user.sh; do
    if [[ -x "${seed_script}" ]]; then
        "${seed_script}" --dest "${HOME}" || \
            echo "hornero-desktop-base: ${seed_script} returned non-zero, continuing" >&2
        break
    fi
done

# Additively refresh the user Hyprland entrypoint from the packaged factory
# (preserves all *-user.lua modules and custom edits).
if command -v horneroctl >/dev/null 2>&1 && [[ -f "${CONFIG_HOME}/hypr/hyprland.lua" ]]; then
    horneroctl config refresh-hypr --yes || \
        echo "hornero-desktop-base: config refresh-hypr returned non-zero, continuing" >&2
fi

# Seed HorneroOS user systemd slices and local-model service drop-ins when absent.
SYSTEMD_USER_DIR="${CONFIG_HOME}/systemd/user"
for rel in \
    "app-models.slice" \
    "app-agents.slice" \
    "ollama.service.d/10-hornero.conf" \
    "llama-server@.service.d/10-hornero.conf"; do
    dest="${SYSTEMD_USER_DIR}/${rel}"
    if [[ -e "${dest}" || -L "${dest}" ]]; then
        continue
    fi
    if [[ -f "/usr/lib/systemd/user/${rel}" ]]; then
        continue
    fi
    tmp="$(mktemp)"
    if curl -fsSL --max-time 20 "${HORNERO_CONFIG_RAW}/desktop/systemd/user/${rel}" -o "${tmp}" && grep -q '^\[' "${tmp}"; then
        mkdir -p "$(dirname "${dest}")"
        install -m 0644 "${tmp}" "${dest}"
        echo "hornero-desktop-base: seeded ${dest} from HorneroOS/config"
    else
        echo "hornero-desktop-base: could not fetch systemd unit ${rel}, skipping" >&2
    fi
    rm -f "${tmp}"
done

for unit in dunst.service mako.service swaync.service; do
    path="${CONFIG_HOME}/systemd/user/${unit}"
    if [[ -e "${path}" && ! -L "${path}" ]]; then
        echo "hornero-desktop-base: keeping user-authored ${path}" >&2
        continue
    fi
    mkdir -p "$(dirname "${path}")"
    ln -sfn /dev/null "${path}"
done
# Daemons that D-Bus-activate without systemd (Arch mako) bypass a masked
# unit: shadow their D-Bus service files with user-level no-ops.
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
for svc in org.knopwob.dunst.service fr.emersion.mako.service org.erikreider.swaync.service; do
    file="${DATA_HOME}/dbus-1/services/${svc}"
    if [[ -e "${file}" ]] && ! grep -q '^# hornero: notification daemon shadow' "${file}"; then
        echo "hornero-desktop-base: keeping user-authored ${file}" >&2
        continue
    fi
    mkdir -p "$(dirname "${file}")"
    printf '%s\n' '# hornero: notification daemon shadow (the shell owns org.freedesktop.Notifications)' \
        '[D-BUS Service]' 'Name=org.freedesktop.Notifications' 'Exec=/bin/false' > "${file}"
done
systemctl --user daemon-reload 2>/dev/null || true
# A daemon that already owns the name keeps it until it exits.
systemctl --user stop dunst.service mako.service swaync.service 2>/dev/null || true
for daemon in dunst mako swaync; do
    pkill -x "${daemon}" 2>/dev/null || true
done
{{      end -}}

{{ end -}}
