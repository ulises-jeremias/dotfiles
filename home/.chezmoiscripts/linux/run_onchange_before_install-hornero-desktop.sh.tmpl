{{ if and (not .ephemeral) (not .headless) (not (get . "horneroNative")) -}}

{{      if eq .osid "linux-arch" -}}
#!/usr/bin/env bash

set -euo pipefail

# Replace the retired VCS Quickshell package before installing the stable
# repository package; pacman marks the two package names as conflicting.
if pacman -Qq quickshell-git >/dev/null 2>&1; then
  yay -R --noconfirm quickshell-git
fi

# Replace the old AUR Cava shared library with the Arch `libcava` dependency
# required by the packaged Shell. Both packages own the same /usr files.
if pacman -Qq lib-cava >/dev/null 2>&1; then
  yay -R --noconfirm lib-cava
fi

# Keep CMake/Make builds bounded on workstations with limited memory.
export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-2}"
export MAKEFLAGS=-j2

# Hornero product code, its catalogue, and its CLI come from AUR packages.
# The desktop source checkout is not cloned or built into the user's home.

yay -S --noconfirm --needed \
  quickshell \
  hornero-shell \
  hornero-config \
  horneroctl-bin

# Require package versions whose layout, theme catalogue, Shell runtime,
# compositor-aware Settings focus, and terminal-inventory CLI contract agree
# with the current release.
# Changing these floors reruns this installer so the host can reconcile with AUR.
readonly min_hornero_config_version="0.3.20-1"
readonly min_hornero_shell_version="1.2.64-1"
readonly min_horneroctl_version="0.2.0_preview43-1"
installed_hornero_config_version="$(pacman -Q hornero-config | awk '{print $2}')"
if (( $(vercmp "$installed_hornero_config_version" "$min_hornero_config_version") < 0 )); then
  echo "hornero-config ${min_hornero_config_version} or newer is required for the system layout catalogue (found ${installed_hornero_config_version})" >&2
  exit 1
fi
installed_hornero_shell_version="$(pacman -Q hornero-shell | awk '{print $2}')"
if (( $(vercmp "$installed_hornero_shell_version" "$min_hornero_shell_version") < 0 )); then
  echo "hornero-shell ${min_hornero_shell_version} or newer is required for Settings focus and terminal selection (found ${installed_hornero_shell_version})" >&2
  exit 1
fi
installed_horneroctl_version="$(pacman -Q horneroctl-bin | awk '{print $2}')"
if (( $(vercmp "$installed_horneroctl_version" "$min_horneroctl_version") < 0 )); then
  echo "horneroctl-bin ${min_horneroctl_version} or newer is required for Settings terminal inventory (found ${installed_horneroctl_version})" >&2
  exit 1
fi

# Hornero Signal (visual language, experience modes, Chromatic, PluginKit 3)
# needs these releases. They are advisory until the packages are published to
# the AUR; promote them to hard floors above in the same change that publishes
# them. Older hosts keep working, they just do not get Signal yet.
readonly signal_config_version="0.4.0-1"
readonly signal_shell_version="1.3.0-1"
readonly signal_horneroctl_version="0.2.0_preview46-1"
signal_ready=1
(( $(vercmp "$installed_hornero_config_version" "$signal_config_version") >= 0 )) || signal_ready=0
(( $(vercmp "$installed_hornero_shell_version" "$signal_shell_version") >= 0 )) || signal_ready=0
(( $(vercmp "$installed_horneroctl_version" "$signal_horneroctl_version") >= 0 )) || signal_ready=0
if (( signal_ready == 0 )); then
  echo "note: Hornero Signal needs hornero-config >= ${signal_config_version}, hornero-shell >= ${signal_shell_version}, horneroctl-bin >= ${signal_horneroctl_version}; found ${installed_hornero_config_version}, ${installed_hornero_shell_version}, ${installed_horneroctl_version}. Re-run chezmoi apply after they reach the AUR." >&2
fi

# Hornero Signal ships IBM Plex as its only type family; config and shell
# depend on ttf-ibm-plex, listed here too so a stale host converges.
yay -S --noconfirm --needed \
  ttf-ibm-plex \
  ttf-cascadia-code-nerd

# Pre-Signal shells (< 1.3.0) still render icons with Material Symbols and
# text with Rubik. Keep those two fonts only while such a shell is installed;
# once hornero-shell >= 1.3.0 is in place they are dead weight. This script
# never removes them: after upgrading, `sudo pacman -Rns
# ttf-material-symbols-variable-git ttf-rubik-vf` is a safe, optional cleanup.
if (( $(vercmp "$installed_hornero_shell_version" "1.3.0-1") < 0 )); then
  yay -S --noconfirm --needed \
    ttf-material-symbols-variable-git \
    ttf-rubik-vf
fi

# Theme assets used by the packaged appearance catalogue and Shell. Papirus
# covers Hornero Originals; Orchis and Numix make the external recipe looks
# selectable on a clean machine. qt6ct supplies the Qt platform-theme defaults.
yay -S --noconfirm --needed \
  papirus-icon-theme \
  orchis-theme \
  numix-circle-icon-theme-git \
  qt6ct

