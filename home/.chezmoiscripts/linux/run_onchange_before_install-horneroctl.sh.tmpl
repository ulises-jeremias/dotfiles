{{ if and (not .ephemeral) (not .headless) -}}

{{      if eq .osid "linux-arch" -}}
#!/usr/bin/env bash

set -euo pipefail

# The AUR package owns the CLI. A user-local binary must never satisfy this
# dependency: it can shadow the packaged version and drift from the desktop.

# Canonical binary distribution (same pattern as agent-toolkit-bin).
# The aur-helper script sorts earlier (install-000-aur-helper), so an
# AUR helper is available here on a normal apply.
if command -v yay >/dev/null 2>&1; then
    yay -S --noconfirm --needed horneroctl-bin
elif command -v paru >/dev/null 2>&1; then
    paru -S --noconfirm --needed horneroctl-bin
else
    echo "horneroctl-install requires an AUR helper (yay or paru)" >&2
    exit 1
fi

if ! pacman -Qq horneroctl-bin >/dev/null 2>&1; then
    echo "horneroctl-install failed: horneroctl-bin is not installed" >&2
    exit 1
fi

if ! pacman -Qoq /usr/bin/horneroctl 2>/dev/null | grep -Fxq 'horneroctl-bin'; then
    echo "horneroctl-install failed: /usr/bin/horneroctl is not owned by horneroctl-bin" >&2
    exit 1
fi
{{      end -}}

{{ end -}}
