{{- if and (eq .osid "linux-arch") (get . "horneroNative") -}}
#!/usr/bin/env bash

set -euo pipefail

# One-time migration (chezmoi run_once): remove the Kitty configs
# retired in #347, whose sources no longer exist in this repo. A
# leftover target would silently override the packaged hornero-config
# Kitty defaults forever.
#
# Removal happens only when the native replacement is actually
# installed (hornero-config >= 0.3.14, which materializes
# desktop/kitty). Because this is run_once, a kitty.conf the user
# creates afterwards is personal configuration and is never deleted
# by a later apply. See docs/Chezmoi-Migration-Ledger.md.
pkg_version="$(pacman -Q hornero-config 2>/dev/null | awk '{print $2}' || true)"
if [ -z "$pkg_version" ]; then
  exit 0
fi
if command -v vercmp >/dev/null 2>&1; then
  if [ "$(vercmp "$pkg_version" "0.3.14")" -lt 0 ]; then
    exit 0
  fi
fi

# chezmoi always targets ~/.config for dot_config, regardless of
# XDG_CONFIG_HOME; match that exactly.
config_home="$HOME/.config"
for name in kitty.conf hornero-dark.conf hornero-light.conf pampa.conf; do
  target="$config_home/kitty/$name"
  # Regular files only: never delete through a symlink.
  if [ -f "$target" ] && [ ! -L "$target" ]; then
    rm -f "$target"
    echo "removed retired Kitty config: $target"
  fi
done
{{ end -}}
