#!/usr/bin/env bash

set -euo pipefail

# Installation step for the REAPER music studio (docs/REAPER-Vocal-Studio.md).
# Sets four REAPER preferences in reaper.ini, the same ones you would set in
# Preferences > Audio > Device and Preferences > Project:
#   linux_audio_nch_in=2    JACK inputs: Scarlett Input 1 (mic) and Input 2 (guitar)
#   linux_audio_nch_out=6   JACK outputs: 1-2 headphones, 3-4 Discord lesson, 5-6 OBS
#   jack_options |= 2       do not auto-connect to hardware (the qpwgraph patchbay routes)
#   newprojtmpl=...         default template: "Music Studio" (opens ready to play)
#   loadlastproj=0          open a new project from that template on startup
#
# Idempotent; changes nothing when the values are already set. REAPER rewrites
# reaper.ini when it quits, so while REAPER is running this only reports and
# waits for the next apply. A one-time backup is kept in
# ~/.local/state/reaper-backups/reaper.ini.pre-music-studio.
dest_dir="{{ .chezmoi.destDir }}"
ini="$dest_dir/.config/REAPER/reaper.ini"
template="$dest_dir/.config/REAPER/ProjectTemplates/Music Studio.RPP"
backup_dir="$dest_dir/.local/state/reaper-backups"

# qpwgraph (the patchbay that keeps the links) autostarts minimized: that needs
# its tray icon, otherwise "minimized" means no window and it exits at once
# (measured). Same keys as qpwgraph's Setup > System tray options. qpwgraph
# rewrites this file when it quits, so it is only edited while not running.
qpw_conf="$dest_dir/.config/rncbc.org/qpwgraph.conf"
if ! pgrep -x qpwgraph >/dev/null 2>&1; then
  mkdir -p "$(dirname "$qpw_conf")"
  touch "$qpw_conf"
  python3 - "$qpw_conf" <<'PY'
import re
import sys

path = sys.argv[1]
text = open(path, encoding="utf-8").read()
want = {"SystemTray": "true", "SystemTrayQueryClose": "false", "StartMinimized": "true"}
m = re.search(r"(?m)^\[Options\]\n", text)
if not m:
    text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + "[Options]\n"
    m = re.search(r"(?m)^\[Options\]\n", text)
start = m.end()
nxt = re.search(r"(?m)^\[", text[start:])
end = start + nxt.start() if nxt else len(text)
section = text[start:end]
for key, value in want.items():
    if re.search(rf"(?m)^{key}=", section):
        section = re.sub(rf"(?m)^{key}=.*$", f"{key}={value}", section)
    else:
        section = f"{key}={value}\n" + section
new = text[:start] + section + text[end:]
if new != text:
    open(path, "w", encoding="utf-8").write(new)
    print("REAPER music studio: enabled the qpwgraph tray icon (patchbay starts minimized)")
PY
fi

[ -f "$ini" ] || exit 0           # REAPER never started yet: nothing to configure
[ -f "$template" ] || exit 0      # template not deployed yet

if pgrep -x reaper >/dev/null 2>&1; then
  if ! grep -qx 'linux_audio_nch_out=6' "$ini"; then
    echo "REAPER music studio: close REAPER and run 'chezmoi apply' again to set its audio outputs" >&2
  fi
  exit 0
fi

mkdir -p "$backup_dir"
[ -e "$backup_dir/reaper.ini.pre-music-studio" ] || cp -p "$ini" "$backup_dir/reaper.ini.pre-music-studio"

python3 - "$ini" "$template" <<'PY'
import re
import sys

ini, template = sys.argv[1], sys.argv[2]
text = open(ini, encoding="utf-8", errors="surrogateescape").read()
m = re.search(r"(?m)^\[reaper\]\n", text)
if not m:
    text += "\n[reaper]\n"
    m = re.search(r"(?m)^\[reaper\]\n", text)
start = m.end()
nxt = re.search(r"(?m)^\[", text[start:])
end = start + nxt.start() if nxt else len(text)
section = text[start:end]

def get(key):
    v = re.search(rf"(?m)^{re.escape(key)}=(.*)$", section)
    return v.group(1) if v else None

try:
    jack_options = int(get("jack_options") or "0")
except ValueError:
    jack_options = 0
want = {
    "linux_audio_nch_in": "2",
    "linux_audio_nch_out": "6",
    "jack_options": str(jack_options | 2),
    "newprojtmpl": template,
    "loadlastproj": "0",
}
changed = []
for key, value in want.items():
    if get(key) == value:
        continue
    if get(key) is None:
        section = f"{key}={value}\n" + section
    else:
        section = re.sub(rf"(?m)^{re.escape(key)}=.*$", f"{key}={value}", section)
    changed.append(key)
if changed:
    open(ini, "w", encoding="utf-8", errors="surrogateescape").write(text[:start] + section + text[end:])
    print("REAPER music studio: set " + ", ".join(changed) + " in reaper.ini")
PY
