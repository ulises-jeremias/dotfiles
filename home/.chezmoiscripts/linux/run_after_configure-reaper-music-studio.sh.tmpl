#!/usr/bin/env bash

set -euo pipefail

# Installation step for the REAPER music studio (docs/REAPER-Vocal-Studio.md).
# Applies two sets of application preferences ONCE (a marker per set), so a
# later change you make in the application's own settings is never reverted:
#
# 1. REAPER (Preferences > Audio > Device and Preferences > Project):
#      linux_audio_nch_in=4    JACK inputs: 1 mic, 2 guitar DI, 3-4 Browser Backing stereo
#      linux_audio_nch_out=6   JACK outputs: 1-2 headphones, 3-4 Discord lesson, 5-6 OBS
#      jack_options |= 2       do not auto-connect to hardware (the qpwgraph patchbay routes)
#      newprojtmpl=...         default template: "Music Studio" (opens ready to play)
#      loadlastproj=0          open a new project from that template on startup
# 2. qpwgraph (Setup > System tray): tray icon on and start minimized. The
#    patchbay autostarts with --minimized, and without the tray icon qpwgraph
#    exits at once (measured).
#
# Each set waits while its application is running (both rewrite their config
# when they quit) and is retried on the next apply. Writes are atomic. A
# one-time copy of reaper.ini is kept in
# ~/.local/state/reaper-backups/reaper.ini.pre-music-studio.
# To apply a set again, delete its marker in ~/.local/state/reaper-studio/.
dest_dir="{{ .chezmoi.destDir }}"
ini="$dest_dir/.config/REAPER/reaper.ini"
template="$dest_dir/.config/REAPER/ProjectTemplates/Music Studio.RPP"
qpw_conf="$dest_dir/.config/rncbc.org/qpwgraph.conf"
backup_dir="$dest_dir/.local/state/reaper-backups"
state_dir="$dest_dir/.local/state/reaper-studio"
reaper_marker="$state_dir/reaper-prefs-v1-done"
reaper_in4_marker="$state_dir/reaper-nch-in4-v1-done"
qpw_marker="$state_dir/qpwgraph-tray-v1-done"

# set_ini_keys FILE SECTION KEY=VALUE...  (merges keys into one INI section)
# jack_options is OR-ed with the given value so other JACK option bits survive.
set_ini_keys() {
  python3 - "$@" <<'PY'
import os
import re
import sys

path, section_name, *pairs = sys.argv[1:]
want = dict(p.split("=", 1) for p in pairs)
text = open(path, encoding="utf-8", errors="surrogateescape").read() if os.path.exists(path) else ""
header = re.compile(rf"(?m)^\[{re.escape(section_name)}\]\n")
m = header.search(text)
if not m:
    text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + f"[{section_name}]\n"
    m = header.search(text)
start = m.end()
nxt = re.search(r"(?m)^\[", text[start:])
end = start + nxt.start() if nxt else len(text)
section = text[start:end]


def current(key):
    v = re.search(rf"(?m)^{re.escape(key)}=(.*)$", section)
    return v.group(1) if v else None


if "jack_options" in want:
    try:
        want["jack_options"] = str(int(current("jack_options") or "0") | int(want["jack_options"]))
    except ValueError:
        pass
changed = []
for key, value in want.items():
    if current(key) == value:
        continue
    if current(key) is None:
        section = f"{key}={value}\n" + section
    else:
        section = re.sub(rf"(?m)^{re.escape(key)}=.*$", lambda _m, k=key, v=value: f"{k}={v}", section)
    changed.append(key)
if changed:
    tmp = path + ".music-studio.tmp"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as fh:
        fh.write(text[:start] + section + text[end:])
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)
    print(f"REAPER music studio: set {', '.join(changed)} in {os.path.basename(path)}")
PY
}

mkdir -p "$state_dir"

# 2. qpwgraph tray (independent of REAPER)
if [ ! -e "$qpw_marker" ] && ! pgrep -x qpwgraph >/dev/null 2>&1; then
  mkdir -p "$(dirname "$qpw_conf")"
  set_ini_keys "$qpw_conf" Options SystemTray=true SystemTrayQueryClose=false StartMinimized=true
  date -u +%Y-%m-%dT%H:%M:%SZ >"$qpw_marker"
fi

# 1. REAPER preferences
if [ -e "$reaper_marker" ] && [ -e "$reaper_in4_marker" ]; then exit 0; fi
[ -f "$template" ] || exit 0 # template not deployed yet
if pgrep -x reaper >/dev/null 2>&1; then
  echo "REAPER music studio: close REAPER and run 'chezmoi apply' again to set its audio outputs" >&2
  exit 0
fi
mkdir -p "$backup_dir"
# On a fresh install REAPER has not created reaper.ini yet: start one with just
# these keys, so the first REAPER start already uses four inputs, six outputs
# and the Music Studio template (REAPER fills in every other default itself).
if [ -f "$ini" ]; then
  [ -e "$backup_dir/reaper.ini.pre-music-studio" ] || cp -p "$ini" "$backup_dir/reaper.ini.pre-music-studio"
fi
if [ ! -e "$reaper_marker" ]; then
  set_ini_keys "$ini" reaper linux_audio_nch_in=4 linux_audio_nch_out=6 jack_options=2 \
    "newprojtmpl=$template" loadlastproj=0
  date -u +%Y-%m-%dT%H:%M:%SZ >"$reaper_marker"
else
  set_ini_keys "$ini" reaper linux_audio_nch_in=4
fi
date -u +%Y-%m-%dT%H:%M:%SZ >"$reaper_in4_marker"
