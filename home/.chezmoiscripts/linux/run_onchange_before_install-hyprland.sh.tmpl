#!/usr/bin/env bash
set -euo pipefail

# Hyprland and Wayland core packages
yay -S --noconfirm --needed \
  hyprland \
  xdg-desktop-portal \
  xdg-desktop-portal-hyprland \
  xdg-desktop-portal-gtk \
  qt5-wayland \
  qt6-wayland \
  polkit-gnome \
  xwaylandvideobridge

# Notification library (Quickshell handles notification display)
yay -S --noconfirm --needed libnotify

# Screen locking and idle management
yay -S --noconfirm --needed \
  hyprlock \
  hypridle

# Screenshots
yay -S --noconfirm --needed \
  grim \
  slurp \
  swappy

# Wallpaper management
yay -S --noconfirm --needed \
  swaybg

# Clipboard manager
yay -S --noconfirm --needed \
  wl-clipboard \
  cliphist

# Additional utilities
yay -S --noconfirm --needed \
  dex \
  brightnessctl \
  hyprpicker

# NOTE: playerctl and pamixer are installed by run_onchange_before_install-packages.sh.tmpl
#       to avoid duplication here. Both are Wayland/X11 agnostic utilities.

# ScrollOverview plugin (niri-style overview) — managed by hyprpm.
# hyprpm ships with hyprland, so no extra package is required.
# Build dependencies required by hyprpm to compile plugins against the
# installed Hyprland headers. The plugin's hyprpm.toml uses `make all`, so
# `make` is required. See https://wiki.hypr.land/Plugins/Using-Plugins/
yay -S --noconfirm --needed \
  cmake \
  cpio \
  pkg-config \
  git \
  gcc \
  make \
  jq

# Bootstrap the plugin idempotently. `hyprpm add --force` does NOT skip the
# "repository already installed" check, so we guard `add` with `hyprpm list`
# and only add when the repo is absent. `update` builds/refreshes headers and
# plugins from the installed Hyprland package state and does not require a
# running session. `enable` is a no-op if already enabled. We do NOT suppress
# genuine failures so a real bootstrap error aborts the script instead of
# leaving the plugin configured-but-missing. Release build => main branch.
SCROLL_OVERVIEW_URL="https://github.com/yayuuu/hyprland-scroll-overview.git"
if ! hyprpm list 2>/dev/null | grep -q 'hyprland-scroll-overview'; then
  hyprpm add "${SCROLL_OVERVIEW_URL}"
fi
hyprpm update
hyprpm enable scrolloverview

# Best-effort reload so an already-running Hyprland session picks up the
# plugin immediately; ignore failures (no session running on first install,
# and autostart.conf handles loading on next compositor start).
hyprpm reload 2>/dev/null || true

{{      end -}}

{{ end -}}
