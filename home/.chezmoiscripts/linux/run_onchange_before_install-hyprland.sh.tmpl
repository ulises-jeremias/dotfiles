#!/usr/bin/env bash
set -euo pipefail

# Hyprland and Wayland core packages
yay -S --noconfirm --needed \
  hyprland \
  xdg-desktop-portal \
  xdg-desktop-portal-hyprland \
  xdg-desktop-portal-gtk \
  qt5-wayland \
  qt6-wayland \
  polkit-gnome \
  xwaylandvideobridge

# Notification library (Quickshell handles notification display)
yay -S --noconfirm --needed libnotify

# Screen locking and idle management
yay -S --noconfirm --needed \
  hyprlock \
  hypridle

# Screenshots
yay -S --noconfirm --needed \
  grim \
  slurp \
  swappy

# Wallpaper management
yay -S --noconfirm --needed \
  swaybg

# Clipboard manager
yay -S --noconfirm --needed \
  wl-clipboard \
  cliphist

# Additional utilities
yay -S --noconfirm --needed \
  dex \
  brightnessctl \
  hyprpicker

# NOTE: playerctl and pamixer are installed by run_onchange_before_install-packages.sh.tmpl
#       to avoid duplication here. Both are Wayland/X11 agnostic utilities.

# ScrollOverview plugin (niri-style overview) — managed by hyprpm.
# hyprpm ships with hyprland, so no extra package is required.
# Build dependencies required by hyprpm to compile plugins against the
# installed Hyprland headers. The plugin's hyprpm.toml uses `make all`, so
# `make` is required. See https://wiki.hypr.land/Plugins/Using-Plugins/
yay -S --noconfirm --needed \
  cmake \
  cpio \
  pkg-config \
  git \
  gcc \
  make \
  jq

# Bootstrap the ScrollOverview plugin via hyprpm.
# `hyprpm update` builds/installs the Hyprland headers used to compile plugins
# and can run without an active Hyprland session. It must run as the USER
# (hyprpm refuses root); it internally invokes sudo for privileged steps like
# installing headers into /var/cache/hyprpm.
#
# The actual `hyprpm add`/`enable`/`reload` steps need a running session, so
# they are handled by the idempotent `dots-hyprland-plugins` script: it is
# invoked here when a session is active, and on every login via autostart
# (exec-once), so a first install that happens outside a session is completed
# automatically at the next login.
#
# Force header rebuild to match the installed Hyprland version.
hyprpm update -f

# If a Hyprland session is active, bootstrap the plugins right away.
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl -j version >/dev/null 2>&1; then
  ~/.local/bin/dots-hyprland-plugins
fi

{{      end -}}

{{ end -}}
