#!/usr/bin/env bash
set -euo pipefail

# Hyprland and Wayland core packages
yay -S --noconfirm --needed \
  hyprland \
  xdg-desktop-portal \
  xdg-desktop-portal-hyprland \
  xdg-desktop-portal-gtk \
  qt5-wayland \
  qt6-wayland \
  polkit-gnome \
  xwaylandvideobridge

# Notification library (Quickshell handles notification display)
yay -S --noconfirm --needed libnotify

# Screen locking and idle management
yay -S --noconfirm --needed \
  hyprlock \
  hypridle

# Screenshots
yay -S --noconfirm --needed \
  grim \
  slurp \
  swappy

# Wallpaper management
yay -S --noconfirm --needed \
  swaybg

# Clipboard manager
yay -S --noconfirm --needed \
  wl-clipboard \
  cliphist

# Additional utilities
yay -S --noconfirm --needed \
  dex \
  brightnessctl \
  hyprpicker

# NOTE: playerctl and pamixer are installed by run_onchange_before_install-packages.sh.tmpl
#       to avoid duplication here. Both are Wayland/X11 agnostic utilities.

# ScrollOverview plugin (niri-style overview) — managed by hyprpm.
# hyprpm ships with hyprland, so no extra package is required.
# Build dependencies required by hyprpm to compile plugins against the
# installed Hyprland headers. The plugin's hyprpm.toml uses `make all`, so
# `make` is required. See https://wiki.hypr.land/Plugins/Using-Plugins/
yay -S --noconfirm --needed \
  cmake \
  cpio \
  pkg-config \
  git \
  gcc \
  make \
  jq

# Bootstrap the ScrollOverview plugin via hyprpm.
# `hyprpm add` and `hyprpm enable` require a running Hyprland session (they
# query the compositor and ensure plugin load state), so we gate on
# HYPRLAND_INSTANCE_SIGNATURE / `hyprctl -j version`. On first install there
# is no session yet; the autostart `exec-once = hyprpm reload` entry will load
# the plugin on the next compositor start once the user runs the bootstrap
# manually (see the warning below).
#
# `hyprpm update -f` must run as the USER (hyprpm refuses root); it internally
# invokes sudo for privileged steps like installing headers into /var/cache/hyprpm.
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl -j version >/dev/null 2>&1; then
  # Idempotent: only add if the repo isn't already installed.
  # Capture the output first to avoid `pipefail` + `grep -q` SIGPIPE issues.
  plugin_list="$(hyprpm list 2>/dev/null)"
  if ! grep -Fq -- 'hyprland-scroll-overview' <<<"$plugin_list"; then
    hyprpm add https://github.com/yayuuu/hyprland-scroll-overview.git
  fi
  # Force header rebuild to match the installed Hyprland version.
  hyprpm update -f
  hyprpm enable scrolloverview
  # Reload the running session to pick up the plugin immediately.
  hyprpm reload 2>/dev/null || true
else
  echo "WARNING: No active Hyprland session. ScrollOverview plugin bootstrap skipped." >&2
  echo "After logging into Hyprland, run:" >&2
  echo "  hyprpm update -f && hyprpm add https://github.com/yayuuu/hyprland-scroll-overview.git && hyprpm enable scrolloverview" >&2
fi

{{      end -}}

{{ end -}}
