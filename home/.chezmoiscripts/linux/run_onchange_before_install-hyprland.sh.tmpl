#!/usr/bin/env bash
set -euo pipefail

# Hyprland and Wayland core packages
yay -S --noconfirm --needed \
  hyprland \
  xdg-desktop-portal \
  xdg-desktop-portal-hyprland \
  xdg-desktop-portal-gtk \
  qt5-wayland \
  qt6-wayland \
  polkit-gnome \
  xwaylandvideobridge

# Notification library (Quickshell handles notification display)
yay -S --noconfirm --needed libnotify

# Screen locking and idle management
yay -S --noconfirm --needed \
  hyprlock \
  hypridle

# Screenshots
yay -S --noconfirm --needed \
  grim \
  slurp \
  swappy

# Wallpaper management
yay -S --noconfirm --needed \
  swaybg

# Clipboard manager
yay -S --noconfirm --needed \
  wl-clipboard \
  cliphist

# Additional utilities
yay -S --noconfirm --needed \
  dex \
  brightnessctl \
  hyprpicker

# NOTE: playerctl and pamixer are installed by run_onchange_before_install-packages.sh.tmpl
#       to avoid duplication here. Both are Wayland/X11 agnostic utilities.

# ScrollOverview plugin (niri-style overview) — managed by hyprpm.
# hyprpm ships with hyprland, so no extra package is required.
# Build dependencies required by hyprpm to compile plugins against the
# installed Hyprland headers. The plugin's hyprpm.toml uses `make all`, so
# `make` is required. See https://wiki.hypr.land/Plugins/Using-Plugins/
yay -S --noconfirm --needed \
  cmake \
  cpio \
  pkg-config \
  git \
  gcc \
  make \
  jq

# Bootstrap the ScrollOverview plugin via hyprpm.
# hyprpm stores its cache (headers, built plugins) under /var/cache/hyprpm,
# which is owned by root, so `sudo` is required for update/purge-cache.
# `sudo -n` uses the cached sudo credentials from `yay` above (which already
# prompted for the password). If the timestamp expired, the script aborts
# cleanly instead of hanging on a hidden prompt.
if ! sudo -n true 2>/dev/null; then
  echo "WARNING: sudo credentials expired. Skipping ScrollOverview bootstrap." >&2
  echo "Run 'sudo hyprpm update -f && hyprpm add https://github.com/yayuuu/hyprland-scroll-overview.git && hyprpm enable scrolloverview' manually." >&2
else
  # Idempotent: only add if the repo isn't already installed.
  if ! hyprpm list 2>/dev/null | grep -q 'hyprland-scroll-overview'; then
    hyprpm add https://github.com/yayuuu/hyprland-scroll-overview.git
  fi
  # Force header rebuild to match the installed Hyprland version.
  sudo -n hyprpm update -f
  hyprpm enable scrolloverview
  # Best-effort reload for an already-running session (no-op on first install).
  hyprpm reload 2>/dev/null || true
fi

