{
  "_name": "Dock Bottom",
  "_description": "Bottom dock — launcher, workspaces, pinned apps, tools and status",
  "_icon": "🛟",
  "_iconMaterial": "dock_to_bottom",
  "_lineage": "Waybar dock-bottom profile",
  "bar": {
    "position": "bottom",
    "style": "dock",
    "floatingMargin": 12,
    "persistent": true,
    "showOnHover": true,
    "entries": [
      {
        "id": "logo",
        "enabled": true
      },
      {
        "id": "workspaces",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "pinnedApps",
        "enabled": true
      },
      {
        "id": "quickActions",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "clock",
        "enabled": true
      },
      {
        "id": "statusIcons",
        "enabled": true
      },
      {
        "id": "battery",
        "enabled": true
      },
      {
        "id": "tray",
        "enabled": true
      }
    ],
    "bars": [
      {
        "edge": "bottom",
        "style": "dock",
        "margin": 12,
        "thickness": 40,
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "workspaces",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "pinnedApps",
              "enabled": true,
              "options": {
                "apps": [
                  "kitty",
                  "thunar",
                  "firefox"
                ]
              }
            },
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker"
                ]
              }
            }
          ],
          "end": [
            {
              "id": "clock",
              "enabled": true
            },
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "battery",
              "enabled": true
            },
            {
              "id": "tray",
              "enabled": true
            }
          ]
        }
      }
    ],
    "sizes": {
      "innerWidth": 40
    },
    "status": {
      "showAudio": true,
      "showMicrophone": false,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": false
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    }
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 1.5
    },
    "padding": {
      "scale": 1.2
    },
    "spacing": {
      "scale": 1.2
    },
    "transparency": {
      "enabled": true,
      "base": 0.85,
      "layers": 0.4
    }
  }
}
