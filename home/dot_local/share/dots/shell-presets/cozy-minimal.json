{
  "_name": "Cozy Minimal",
  "_description": "Soft floating top ribbon — workspaces, centred time, a few tools",
  "_icon": "🌸",
  "_iconMaterial": "weekend",
  "_lineage": "Waybar cozy-minimal profile",
  "bar": {
    "position": "top",
    "style": "floating",
    "floatingMargin": 14,
    "persistent": true,
    "showOnHover": true,
    "entries": [
      {
        "id": "logo",
        "enabled": true
      },
      {
        "id": "workspaces",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "clock",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "quickActions",
        "enabled": true
      },
      {
        "id": "statusIcons",
        "enabled": true
      },
      {
        "id": "battery",
        "enabled": true
      },
      {
        "id": "tray",
        "enabled": true
      }
    ],
    "bars": [
      {
        "edge": "top",
        "style": "floating",
        "margin": 14,
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "workspaces",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker",
                  "settings"
                ]
              }
            },
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "battery",
              "enabled": true
            },
            {
              "id": "tray",
              "enabled": true
            }
          ]
        },
        "reserve": true
      }
    ],
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showNetwork": true,
      "showBattery": false,
      "showAudio": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    }
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 1.4
    },
    "padding": {
      "scale": 1.1
    },
    "spacing": {
      "scale": 1.1
    },
    "transparency": {
      "enabled": true,
      "base": 0.9,
      "layers": 0.4
    }
  }
}
