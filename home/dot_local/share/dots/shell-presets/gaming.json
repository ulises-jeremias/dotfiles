{
  "_name": "Gaming",
  "_description": "Bottom bar \u2014 minimal footprint, no logo",
  "_icon": "\ud83c\udfae",
  "_iconMaterial": "sports_esports",
  "bar": {
    "position": "bottom",
    "style": "floating",
    "persistent": true,
    "entries": [
      {
        "id": "workspaces",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "statusIcons",
        "enabled": true
      }
    ],
    "status": {
      "showAudio": true,
      "showNetwork": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": false
    }
  },
  "appearance": {
    "rounding": {
      "scale": 0.9
    },
    "padding": {
      "scale": 0.7
    },
    "spacing": {
      "scale": 0.8
    }
  },
  "notifs": {
    "defaultExpireTimeout": 2000
  },
  "osd": {
    "hideDelay": 1000
  }
}
