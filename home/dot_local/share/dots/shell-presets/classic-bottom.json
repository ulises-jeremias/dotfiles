        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "clock",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "tray",
        "enabled": true
      },
      {
        "id": "statusIcons",
        "enabled": true
      },
      {
        "id": "power",
        "enabled": true
      }
    ],
    "sizes": {
      "innerWidth": 40
