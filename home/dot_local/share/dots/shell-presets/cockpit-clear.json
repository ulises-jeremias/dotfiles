{
  "_name": "Cockpit Clear",
  "_description": "The dual bar with no backdrop: controls and telemetry straight on the wallpaper",
  "_iconMaterial": "blur_on",
  "_lineage": "Polybar default (X11, transparent bars)",
  "bar": {
    "position": "top",
    "style": "attached",
    "floatingMargin": 8,
    "persistent": true,
    "showOnHover": true,
    "entries": [
      {
        "id": "logo",
        "enabled": true
      },
      {
        "id": "quickActions",
        "enabled": true
      },
      {
        "id": "audioSlider",
        "enabled": true
      },
      {
        "id": "brightnessSlider",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "clock",
        "enabled": true
      },
      {
        "id": "weather",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "statusIcons",
        "enabled": true
      },
      {
        "id": "tray",
        "enabled": true
      },
      {
        "id": "power",
        "enabled": true
      }
    ],
    "bars": [
      {
        "edge": "top",
        "style": "attached",
        "backdrop": "clear",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker",
                  "settings"
                ]
              }
            },
            {
              "id": "audioSlider",
              "enabled": true,
              "options": {
                "showValue": true
              }
            },
            {
              "id": "brightnessSlider",
              "enabled": true,
              "options": {
                "showValue": true
              }
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true,
              "options": {
                "showDate": true
              }
            },
            {
              "id": "weather",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "tray",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true
            }
          ]
        }
      },
      {
        "edge": "bottom",
        "style": "attached",
        "backdrop": "clear",
        "thickness": 28,
        "groups": {
          "start": [
            {
              "id": "workspaces",
              "enabled": true,
              "options": {
                "style": "labels"
              }
            }
          ],
          "center": [
            {
              "id": "media",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "kbLayout",
              "enabled": true
            },
            {
              "id": "resources",
              "enabled": true
            }
          ]
        }
      }
    ],
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showMicrophone": false,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": false
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    }
  },
  "border": {
    "frameEnabled": false
  }
}
