#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Thin Hornero replacement for pacman-contrib's checkupdates.
## Prints pending updates using a throwaway sync database so the real
## pacman database is never touched. Drop-in for callers that only need
## the update list (e.g. dots-updates counting lines).
##
## Delegation: a bare invocation prefers `horneroctl package check` when
## that subcommand exists (HORNEROCTL_BIN override, default horneroctl on
## PATH). Flagged invocations (-d/--download, -h/--help) and any
## environment without horneroctl keep the legacy implementation below.
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Usage:
##     @script.name [OPTIONS]
##
## Options:
##     -d, --download          Also download the pending packages into the pacman cache
##     -h, --help              Show this help message

set -euo pipefail

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

DOWNLOAD_CACHE=0

for arg in "$@"; do
  case "$arg" in
    -d | --download)
      DOWNLOAD_CACHE=1
      ;;
    -h | --help)
      echo "Usage: ${0##*/} [-d|--download]"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

# Prefer horneroctl for a bare listing. Cycle guard: `horneroctl package
# check` itself delegates to this script, so when calling outward we pin
# HORNERO_CHECKUPDATES_BIN at the plain pacman-contrib backend. Without
# that pin the call would loop back here forever. Delegation is skipped
# when the contrib backend is missing (or resolves to this very file) and
# the legacy throwaway-database implementation below runs instead.
if (($# == 0)); then
  if command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
    && "$HORNEROCTL_BIN" package check --help >/dev/null 2>&1; then
    contrib="$(command -v checkupdates 2>/dev/null || true)"
    if [[ -n $contrib ]]; then
      self_path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
      contrib_path="$(readlink -f "$contrib" 2>/dev/null || echo "$contrib")"
      if [[ $contrib_path != "$self_path" ]]; then
        export HORNERO_CHECKUPDATES_BIN="$contrib"
        exec "$HORNEROCTL_BIN" package check
      fi
    fi
  fi
fi

if ! command -v pacman >/dev/null 2>&1; then
  echo "[ERROR] pacman not found. This command requires Arch Linux." >&2
  exit 1
fi

db_path="${CHECKUPDATES_DB:-${XDG_CACHE_HOME:-${HOME}/.cache}/checkupdates}"
mkdir -p "$db_path"
db_path="$(realpath "$db_path")"

sync_args=(pacman -Sy --dbpath "$db_path" --logfile /dev/null)
if ((DOWNLOAD_CACHE)); then
  sync_args+=(--downloadonly)
fi

# Refresh the throwaway database; on failure fall back to the real one so
# the caller still gets a best-effort list instead of nothing.
if ! "${sync_args[@]}" >/dev/null 2>&1; then
  echo "[WARN] Temporary sync database refresh failed; using the real database" >&2
  exec pacman -Qu
fi

exec pacman -Qu --dbpath "$db_path"
