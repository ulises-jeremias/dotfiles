#!/usr/bin/env bash

## Copyright (C) 2019-2026 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Program: dots-snappy-switcher
## Description: Snappy Switcher wrapper with appearance theme integration
##
## Usage:
##   dots-snappy-switcher [COMMAND] [ARG]
##
## Commands:
##   daemon                    Start daemon in background mode
##   next                      Focus next window (Alt+Tab)
##   prev                      Focus previous window (Alt+Shift+Tab)
##   toggle                    Toggle switcher visibility
##   hide                      Hide switcher overlay
##   select                    Confirm current selection
##   quit                      Stop snappy-switcher daemon
##   apply-theme <theme>       Apply explicit theme file (e.g. nord.ini)
##   apply-theme-pack [id]     Apply theme from appearance theme pack
##   apply-rice-theme [id]     Deprecated alias for apply-theme-pack
##   status                    Show whether daemon is running
##
## Delegation: every command runs via `horneroctl apps switcher`
## (HORNEROCTL_BIN override, default horneroctl on PATH) when that
## subcommand exists, else the legacy body below. Control commands
## pass --yes because the user invoked this script explicitly.
## Skipped under HORNEROCTL_DELEGATED so a horneroctl-driven backend
## call runs the legacy body instead of calling back.

set -euo pipefail

source ~/.local/lib/dots/easy-options/easyoptions.sh || exit
source ~/.local/lib/dots/snappy-switcher-manager.sh || exit

run_snappy() {
	local cmd="$1"
	shift || true

	if ! command -v snappy-switcher >/dev/null 2>&1; then
		echo "snappy-switcher is not installed."
		echo "Install it with your package manager (AUR: snappy-switcher)."
		return 1
	fi

	snappy-switcher "$cmd" "$@"
}

cmd="${arguments[0]:-toggle}"
arg="${arguments[1]:-}"

_orig_cmd="$cmd"
case "$cmd" in
  daemon | next | prev | toggle | hide | select | quit | status | apply-theme | apply-theme-pack | apply-rice-theme | help | --help | -h) ;;
  *) cmd="__unknown__" ;;
esac
if [[ -z "${HORNEROCTL_DELEGATED:-}" ]] && [[ "$cmd" != "__unknown__" ]] && [[ "$cmd" != help ]] && [[ "$cmd" != --help ]] && [[ "$cmd" != -h ]]; then
  _horneroctl_bin="${HORNEROCTL_BIN:-horneroctl}"
  if command -v "$_horneroctl_bin" >/dev/null 2>&1; then
    _horneroctl_help="$("$_horneroctl_bin" apps --help 2>/dev/null || true)"
    case "$_horneroctl_help" in
      *"Usage: horneroctl apps"*)
        if [[ "$cmd" == status ]]; then
          exec "$_horneroctl_bin" apps switcher status
        elif [[ "$cmd" == apply-theme ]] || [[ "$cmd" == apply-theme-pack ]] || [[ "$cmd" == apply-rice-theme ]]; then
          if [[ -n "$arg" ]]; then
            exec "$_horneroctl_bin" apps switcher "$cmd" "$arg" --yes
          elif [[ "$cmd" == apply-theme-pack ]] || [[ "$cmd" == apply-rice-theme ]]; then
            exec "$_horneroctl_bin" apps switcher "$cmd" --yes
          fi
        else
          exec "$_horneroctl_bin" apps switcher "$cmd" --yes
        fi
        ;;
    esac
  fi
fi

case "$cmd" in
daemon)
	run_snappy --daemon
	;;
next | prev | toggle | hide | select | quit)
	run_snappy "$cmd"
	;;
apply-theme)
	if [[ -z $arg ]]; then
		echo "Usage: dots-snappy-switcher apply-theme <theme>"
		exit 1
	fi
	apply_snappy_switcher_theme "$arg"
	;;
apply-theme-pack | apply-rice-theme)
	apply_theme_snappy_switcher_theme "$arg"
	;;
status)
	if pgrep -x snappy-switcher >/dev/null 2>&1; then
		echo "snappy-switcher daemon: running"
	else
		echo "snappy-switcher daemon: not running"
	fi
	;;
help | --help | -h)
	show_help
	;;
*)
	if [[ "$cmd" == "__unknown__" ]]; then
		echo "Unknown command: $_orig_cmd"
	else
		echo "Unknown command: $cmd"
	fi
	show_help
	exit 1
	;;
esac
