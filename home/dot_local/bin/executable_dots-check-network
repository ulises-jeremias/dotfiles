#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Check if the network is up
##
## Delegation: `--once` runs via `horneroctl hardware network status`
## when that subcommand exists (HORNEROCTL_BIN override, default
## horneroctl on PATH), else the ping probe below. The polling loop
## always stays local: horneroctl owns no streaming verb
## (DOTS_PING_HOST passes through untouched).

set -euo pipefail

HOST="${DOTS_PING_HOST:-1.1.1.1}"
TIMEOUT=25
ONCE=false

usage() {
  echo "Usage: dots check-network [--once] [--timeout=SECONDS]"
  echo "  DOTS_PING_HOST  Ping target (default: 1.1.1.1)"
}

for arg in "$@"; do
  case "$arg" in
    --once)
      ONCE=true
      ;;
    --timeout=*)
      TIMEOUT="${arg#*=}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

# A single-shot `--once` delegates to horneroctl when that subcommand
# exists (TIMEOUT maps to the ping deadline); the polling loop below
# stays local. No cycle risk: `hardware network status` only shells out
# to ping/ip, never back into this script.
if [[ $ONCE == true ]] && command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
  && "$HORNEROCTL_BIN" hardware network --help >/dev/null 2>&1; then
  exec "$HORNEROCTL_BIN" hardware network status --timeout="$TIMEOUT"
fi

wdisconnect="睊"
wconnected="直"
econnected=""
edisconnect=""

while true; do
  network_interface="$(ip link 2>/dev/null | awk '/state UP/ {print $2}' || echo "")"

  if ping -c 1 "$HOST" >/dev/null 2>&1; then
    [[ $network_interface == e* ]] && echo "$econnected" || echo "$wconnected"
    sleep_for="$TIMEOUT"
  else
    [[ $network_interface == e* ]] && echo "$edisconnect" || echo "$wdisconnect"
    sleep_for=0.6
  fi

  if $ONCE; then
    break
  fi

  sleep "$sleep_for"
done
