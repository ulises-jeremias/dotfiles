#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
##     @script.name [OPTION] ARGUMENTS...
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Check for updates (polybar readout).
##
## Update source: `horneroctl package check` when that subcommand exists
## (HORNEROCTL_BIN override, default horneroctl on PATH), else the legacy
## `checkupdates` counting below.

set -euo pipefail

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

# Prefer `horneroctl package check` as the update source when that
# subcommand exists; otherwise count `checkupdates` output as before.
USE_HORNERO=0
if command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
  && "$HORNEROCTL_BIN" package check --help >/dev/null 2>&1; then
  USE_HORNERO=1
fi

BAR_ICON="ﮮ"
NOTIFIED=0

get_total_updates() {
  if ((USE_HORNERO)); then
    # Gate on the exit code: horneroctl prints failure details on stdout,
    # which must not be mistaken for pending-update lines.
    if out="$("$HORNEROCTL_BIN" package check 2>/dev/null)"; then
      if [[ -z $out ]]; then
        UPDATES=0
      else
        UPDATES=$(printf '%s\n' "$out" | wc -l)
      fi
    else
      UPDATES=0
    fi
  else
    UPDATES=$(checkupdates 2>/dev/null | wc -l || echo "0")
  fi
}

while true; do
  # print the icon first to avoid gibberish in polybar
  echo "${BAR_ICON}"

  get_total_updates

  # notify user of updates
  if ((NOTIFIED == 0)) && command -v notify-send >/dev/null 2>&1; then
    if ((UPDATES > 50)); then
      notify-send -u critical "Updates Available" "${UPDATES} packages"
    elif ((UPDATES > 25)); then
      notify-send -u normal "Updates Available" "${UPDATES} packages"
    elif ((UPDATES > 2)); then
      notify-send -u low "Updates Available" "${UPDATES} packages"
    fi
    NOTIFIED=1
  fi

  # when there are updates available
  # every 10 seconds another check for updates is done
  while ((UPDATES > 0)); do
    if ((UPDATES == 1)); then
      echo "${UPDATES} "
    elif ((UPDATES > 1)); then
      echo "${UPDATES} "
    fi
    sleep 10
    get_total_updates
  done

  # when no updates are available, use a longer loop, this saves on CPU
  # and network uptime, only checking once every 30 min for new updates
  while ((UPDATES == 0)); do
    sleep 1800
    get_total_updates
  done
done
