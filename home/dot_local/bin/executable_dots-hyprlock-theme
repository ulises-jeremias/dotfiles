#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## dots-hyprlock-theme: Generate hyprlock color overrides from the current
## smart-colors M3 palette (scheme.json).
##
## Reads the smart-colors scheme.json (contract row 4) and writes a
## hyprlock-compatible source file to colors-hyprlock.conf, which is
## included by ~/.config/hypr/hyprlock.conf via a `source =` directive.
##
## Path contract (HorneroOS/hornero docs/PATH_CONTRACT.md, rows 4 and 9):
## canonical hornero/* first, dots/* fallback for reads; writes go to
## hornero/*. Base resolution is explicit env override -> XDG -> $HOME.
##
## Usage:
##     dots-hyprlock-theme [--wallpaper /path/to/image]

set -euo pipefail

HORNERO_LIB_DIR="${HORNERO_LIB_DIR:-/usr/lib/hornero}"
DOTS_LIB_DIR="${DOTS_LIB_DIR:-$HOME/.local/lib/dots}"
if [[ -f "$HORNERO_LIB_DIR/wallpaper-resolver.sh" ]]; then
	# shellcheck source=/dev/null
	source "$HORNERO_LIB_DIR/wallpaper-resolver.sh"
elif [[ -f "$DOTS_LIB_DIR/wallpaper-resolver.sh" ]]; then
	# shellcheck source=/dev/null
	source "$DOTS_LIB_DIR/wallpaper-resolver.sh"
fi

HORNERO_CACHE_DIR="${HORNERO_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hornero}"
DOTS_CACHE_DIR="${DOTS_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/dots}"
HORNERO_STATE_DIR="${HORNERO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/hornero}"
DOTS_STATE_DIR_FALLBACK="${DOTS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dots}"
HORNERO_SCHEME_FILE="${HORNERO_SCHEME_FILE:-$HORNERO_CACHE_DIR/smart-colors/scheme.json}"
DOTS_SCHEME_FILE_FALLBACK="${DOTS_SCHEME_FILE:-$DOTS_CACHE_DIR/smart-colors/scheme.json}"
HORNERO_WALLPAPER_POINTER_FILE="${HORNERO_WALLPAPER_POINTER_FILE:-$HORNERO_STATE_DIR/wallpaper/path}"
DOTS_WALLPAPER_POINTER_FILE_FALLBACK="${DOTS_WALLPAPER_POINTER_FILE:-$DOTS_STATE_DIR_FALLBACK/wallpaper/path}"

# Canonical-first read: prefer the hornero file when present, else the
# dots fallback (read-only; never written).
if [[ -f $HORNERO_SCHEME_FILE ]]; then
	SCHEME_FILE="$HORNERO_SCHEME_FILE"
else
	SCHEME_FILE="$DOTS_SCHEME_FILE_FALLBACK"
fi
# Writes always target the canonical location.
SMART_COLORS_DIR="$(dirname "$HORNERO_SCHEME_FILE")"
OUTPUT_FILE="${SMART_COLORS_DIR}/colors-hyprlock.conf"
if [[ -f $HORNERO_WALLPAPER_POINTER_FILE ]]; then
	WALLPAPER_POINTER="$HORNERO_WALLPAPER_POINTER_FILE"
else
	WALLPAPER_POINTER="$DOTS_WALLPAPER_POINTER_FILE_FALLBACK"
fi

# ── helpers ──────────────────────────────────────────────────────────────────

hex_to_hyprlock_rgba() {
	# Convert a 6-char hex (#rrggbb) + optional alpha (0-255 as 2-hex) to
	# hyprlock RGBA format: rrggbbaa (no #, always 8 chars)
	local hex="${1#\#}"
	local alpha="${2:-ff}"
	printf '%s%s\n' "$hex" "$alpha"
}

# ── parse scheme.json ─────────────────────────────────────────────────────────

if [[ ! -f $SCHEME_FILE ]]; then
	echo "dots-hyprlock-theme: scheme.json not found at $SCHEME_FILE — run dots-color-scheme first." >&2
	exit 1
fi

read_colour() {
	python3 - "$SCHEME_FILE" "$1" <<'PY'
import json, pathlib, sys
data = json.loads(pathlib.Path(sys.argv[1]).read_text())
key = sys.argv[2]
colours = data.get("colours", {})
val = colours.get(key, "")
print(val if val else "")
PY
}

is_light_mode() {
	python3 - "$SCHEME_FILE" <<'PY'
import json, pathlib, sys
data = json.loads(pathlib.Path(sys.argv[1]).read_text())
print("true" if data.get("mode", "dark") == "light" else "false")
PY
}

# Extract key palette colours
primary="$(read_colour primary)"
surface="$(read_colour surface)"
on_surface="$(read_colour onSurface)"
background="$(read_colour background)"
on_surface_variant="$(read_colour onSurfaceVariant)"
outline="$(read_colour outline)"
secondary="$(read_colour secondary)"
error="$(read_colour error)"
light_mode="$(is_light_mode)"

# Resolve wallpaper path — explicit arg, else canonical pointer, else the
# dots fallback. (The legacy smart-colors/wallpaper cache mirror is not a
# contracted fallback; dots-appearance doctor flags it as an orphan.)
wallpaper=""
if [[ $# -ge 1 && -n ${1:-} ]]; then
	wallpaper="$1"
elif [[ -f $WALLPAPER_POINTER ]]; then
	wallpaper="$(head -n 1 "$WALLPAPER_POINTER" | tr -d '\r')"
fi
# Reject non-existent cache leftovers (e.g. old test PNGs).
if [[ -n ${wallpaper:-} && ! -f $wallpaper ]]; then
	wallpaper=""
fi

# ── generate hyprlock colour override file ────────────────────────────────────

mkdir -p "$SMART_COLORS_DIR"

# Build RGBA values for hyprlock (RRGGBBAA format, no #)
bg_rgba="$(hex_to_hyprlock_rgba "${background:-191114}" "ff")"
surface_rgba="$(hex_to_hyprlock_rgba "${surface:-191114}" "aa")"
primary_rgba="$(hex_to_hyprlock_rgba "${primary:-ffb0ca}" "ff")"
on_surface_rgba="$(hex_to_hyprlock_rgba "${on_surface:-efdfe2}" "ff")"
on_surface_variant_rgba="$(hex_to_hyprlock_rgba "${on_surface_variant:-d5c2c6}" "cc")"
outline_rgba="$(hex_to_hyprlock_rgba "${outline:-9e8c91}" "88")"
secondary_rgba="$(hex_to_hyprlock_rgba "${secondary:-e2bdc7}" "ff")"
input_inner_rgba="$(hex_to_hyprlock_rgba "${surface:-191114}" "bb")"

cat >"$OUTPUT_FILE" <<EOF
# ============================================================================
# hyprlock smart-color overrides
# Auto-generated by dots-hyprlock-theme — do not edit manually.
# Source: $SCHEME_FILE
# ============================================================================

background {
    monitor =
    $(if [[ -n $wallpaper && -f $wallpaper ]]; then
	echo "path = $wallpaper"
else
	echo "color = 0xff${bg_rgba}"
fi)
    blur_passes = 3
    blur_size = 6
    noise = 0.012
    contrast = 0.9
    brightness = $(if [[ $light_mode == "true" ]]; then echo "1.1"; else echo "0.8"; fi)
    vibrancy = 0.15
    vibrancy_darkness = 0.0
}

input-field {
    monitor =
    size = 300, 60
    outline_thickness = 2
    dots_spacing = 0.35
    dots_center = true
    dots_rounding = -1
    fade_on_empty = true
    placeholder_text = <span foreground="##${on_surface_variant_rgba}">  Enter Password</span>
    font_color = rgb(${on_surface:-efdfe2})
    inner_color = rgba(${input_inner_rgba})
    outer_color = rgba(${outline_rgba})
    check_color = rgb(${primary:-ffb0ca})
    fail_color = rgba(${error:-ffb4ab}bb)
    fail_text = <i>\$FAIL_REASON</i>
    fail_timeout = 2000
    rounding = 12
    shadow_passes = 3
    shadow_size = 8
    shadow_color = rgba(00000060)
}

label {
    monitor =
    text = \$TIME12
    text_align = center
    color = rgba(${on_surface_rgba})
    font_size = 56
    font_family = Rubik 300
    position = 0, 160
    halign = center
    valign = center
    shadow_passes = 3
    shadow_size = 6
    shadow_color = rgba(00000088)
}

label {
    monitor =
    text =  \$USER
    text_align = center
    color = rgba(${secondary_rgba})
    font_size = 13
    font_family = Rubik
    position = 0, -80
    halign = center
    valign = center
}
EOF

echo "dots-hyprlock-theme: wrote color overrides to $OUTPUT_FILE"
