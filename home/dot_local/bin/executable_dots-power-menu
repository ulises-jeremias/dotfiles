#!/usr/bin/env bash
## Provenance: COPY (never moved) from ulises-jeremias/dotfiles@b26db04
## home/dot_local/bin/executable_dots-power-menu via read-only reference clone.
## Local changes vs upstream: `executable_` chezmoi deploy prefix stripped;
## lock action falls back to `loginctl lock-session` when dots-lockscreen
## (shipped separately) is not installed.

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Power Menu Wrapper
## Quickshell-first entrypoint for session/power drawer
##
## Delegation: the minimal-menu power actions run via `horneroctl power`
## when that subcommand exists (HORNEROCTL_BIN override, default
## horneroctl on PATH), else the legacy systemctl/loginctl calls below.
## Locking stays with dots-lockscreen (itself a horneroctl shim); the
## quickshell drawer path is owned by the shell family and untouched here.
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Usage:
##     @script.name [OPTIONS]
##
## Options:
##     -h, --help              Show this help message
##         --mode=MODE         Set mode: auto (default), quickshell, minimal
##
## Examples:
##     @script.name
##     @script.name --mode=minimal

set -euo pipefail

# Source EasyOptions for argument parsing
source ~/.local/lib/dots/easy-options/easyoptions.sh || exit

MODE=${mode:-auto}

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

# Prefer `horneroctl power` as the action backend when that subcommand
# exists; otherwise run the legacy systemctl/loginctl calls. No cycle
# risk: `horneroctl power` never calls back into this menu.
USE_HORNERO_POWER=0
if command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
  && "$HORNEROCTL_BIN" power --help >/dev/null 2>&1; then
  USE_HORNERO_POWER=1
fi

# Run one minimal-menu power action: via horneroctl when available
# (the menu choice is the confirmation, so --yes is passed), else the
# legacy implementation kept in this file.
power_action() {
  local verb="$1"
  if ((USE_HORNERO_POWER)); then
    "$HORNEROCTL_BIN" power "$verb" --yes
    return
  fi
  case "$verb" in
    suspend) systemctl suspend ;;
    logout) loginctl terminate-session "${XDG_SESSION_ID-}" ;;
    reboot) systemctl -i reboot ;;
    shutdown) systemctl -i poweroff ;;
  esac
}

launch_quickshell() {
  pgrep -x qs 2>/dev/null || pgrep -x quickshell >/dev/null 2>&1 || return 1
  # Legacy fallback (no horneroctl): normalized drawers form directly.
  quickshell ipc call drawers toggle session
  return 0
}

lock_session() {
  if command -v horneroctl >/dev/null 2>&1; then
    horneroctl lock now --yes
  else
    loginctl lock-session
  fi
}

launch_minimal() {
  cat <<EOF
1) Lock
2) Suspend
3) Logout
4) Reboot
5) Shutdown
EOF
  read -r -p "Select action [1-5]: " choice
  case "$choice" in
    1) lock_session ;;
    2) power_action suspend ;;
    3) power_action logout ;;
    4) power_action reboot ;;
    5) power_action shutdown ;;
    *) exit 0 ;;
  esac
}

main() {
  case "$MODE" in
    quickshell)
      launch_quickshell || {
        echo "quickshell is not running" >&2
        exit 1
      }
      ;;
    minimal)
      launch_minimal
      ;;
    auto | *)
      launch_quickshell || launch_minimal
      ;;
  esac
}

main "$@"
