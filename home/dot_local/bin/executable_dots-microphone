#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Control the microphone
##
## Delegation: `--toggle` runs via `horneroctl hardware mic toggle`
## when that subcommand exists (HORNEROCTL_BIN override, default
## horneroctl on PATH), else the wpctl call below. The event-driven
## listen loop always stays local: horneroctl owns no streaming verb.
##
## Usage:
##   @script.name [OPTIONS]
##
## Options:
##   -h, --help              Show this help message
##   -t, --toggle            Switch microphone to the opposite status
##       --muted-color=COLOR Font color for muted icon
##       --unmuted-color=COLOR Font color for unmuted icon
##       --no-unmuted         Don't show icon when the microphone is enabled

set -euo pipefail

source ~/.local/lib/dots/easy-options/easyoptions.sh || exit

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

# Prefer `horneroctl hardware mic toggle` when that subcommand exists;
# otherwise run the wpctl call below. No cycle risk: `hardware mic`
# only shells out to wpctl, never back into this script.
USE_HORNERO_MIC=0
if command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
  && "$HORNEROCTL_BIN" hardware mic --help >/dev/null 2>&1; then
  USE_HORNERO_MIC=1
fi

reset=""
muted_color="${muted_color:-}"
unmuted_color="${unmuted_color:-}"
# easyoptions boolean flags expand to `yes` (house convention, cf.
# dots-keyboard-layout); compare against that, not `true`, or --toggle
# and --no-unmuted silently fall through to the listen loop.
exec_toggle="${toggle:-no}"
no_unmuted="${no_unmuted:-no}"

get_default_source() {
  # Get the ID of the default microphone (source)
  local default_input_name
  default_input_name="$(wpctl status | grep "Audio/Source" | awk '{print $3}')"
  pw-cli ls Node | grep -B 10 "$default_input_name" | grep -E "^\s*id" | awk '{print $2}' | tr -d ','
}

status() {
  DEFAULT_SOURCE=$(get_default_source)
  MUTED=$(wpctl get-volume "$DEFAULT_SOURCE" | grep -oE '\[MUTED\]')
  if [[ -n $MUTED ]]; then
    echo -e "${muted_color}${reset}" # Muted icon
  else
    [[ ${no_unmuted} != yes ]] && echo -e "${unmuted_color}${reset}" # Unmuted icon
  fi
}

listen() {
  status
  wpctl subscribe | while read -r event; do
    if echo "$event" | grep -q "source" || echo "$event" | grep -q "server"; then
      status
    fi
  done
}

toggle() {
  DEFAULT_SOURCE=$(get_default_source)
  wpctl set-mute "$DEFAULT_SOURCE" toggle
}

if [[ ${exec_toggle} == yes ]]; then
  # An explicit --toggle delegates to horneroctl (the flag is the
  # confirmation, so --yes is passed); otherwise toggle locally.
  if ((USE_HORNERO_MIC)); then
    exec "$HORNEROCTL_BIN" hardware mic toggle --yes
  fi
  toggle
  exit
fi

listen
