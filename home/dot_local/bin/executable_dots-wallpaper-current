#!/usr/bin/env bash
## Provenance: COPY (never moved) from ulises-jeremias/dotfiles@b26db04
## home/dot_local/bin/executable_dots-wallpaper-current via read-only reference clone.
## Local changes vs upstream: `executable_` chezmoi deploy prefix stripped.
## Needs lib/dots/wallpaper-resolver.sh (already shipped).

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## ## Print the path of the currently applied wallpaper
##
## Usage:
##     @script.name [OPTION] ARGUMENTS...
## Print the resolved absolute path to the current wallpaper (same rules as wallpaper-resolver).
set -euo pipefail

# horneroctl delegation (HORNEROCTL_BIN override, default horneroctl on
# PATH): prefer `horneroctl wallpaper current` when the subcommand exists.
# No HORNEROCTL_DELEGATED skip is needed (horneroctl reads natively and
# never calls back), but the guard is honored for symmetry.
if [[ -z "${HORNEROCTL_DELEGATED:-}" ]]; then
  _horneroctl_bin="${HORNEROCTL_BIN:-horneroctl}"
  if command -v "$_horneroctl_bin" >/dev/null 2>&1; then
    _horneroctl_help="$("$_horneroctl_bin" wallpaper --help 2>/dev/null || true)"
    case "$_horneroctl_help" in
    *"Usage: horneroctl wallpaper"*)
      if [[ $# -gt 0 ]]; then
        exec "$_horneroctl_bin" wallpaper current "$1"
      fi
      exec "$_horneroctl_bin" wallpaper current
      ;;
    esac
  fi
  unset _horneroctl_bin _horneroctl_help
fi

if [[ -f "$HOME/.local/lib/dots/wallpaper-resolver.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.local/lib/dots/wallpaper-resolver.sh"
fi

if ! declare -f dots_current_wallpaper >/dev/null 2>&1; then
  exit 1
fi

path="$(dots_current_wallpaper "${1:-}" 2>/dev/null || true)"
if [[ -n ${path:-} && -f $path ]]; then
  printf '%s\n' "$path"
  exit 0
fi

exit 1
