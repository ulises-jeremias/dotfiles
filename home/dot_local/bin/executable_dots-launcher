#!/usr/bin/env bash
## Provenance: COPY (never moved) from ulises-jeremias/dotfiles@b26db04
## home/dot_local/bin/executable_dots-launcher via read-only reference clone.
## Local changes vs upstream: `executable_` chezmoi deploy prefix stripped.

## dots-launcher: Unified application launcher wrapper
## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Delegation: --list and launch run via `horneroctl apps launch`
## (HORNEROCTL_BIN override, default horneroctl on PATH) when that
## subcommand exists, else the legacy body below. Skipped under
## HORNEROCTL_DELEGATED so a horneroctl-driven backend call runs the
## legacy body instead of calling back.
## Preference order (auto): quickshell > minimal prompt
## Usage:
##   @script.name [OPTIONS]
## Options:
##   -h, --help            Show help (auto by EasyOptions)
##       --backend=NAME    Force backend: quickshell|minimal
##       --list            Print detected backends (in priority order) then exit
## Examples:
##   @script.name                  # auto chain
##   @script.name --list           # list available backends

set -euo pipefail

source ~/.local/lib/dots/easy-options/easyoptions.sh || exit

BACKEND=${backend:-auto}
LIST=${list:-no}

launch_quickshell() {
  pgrep -x quickshell >/dev/null 2>&1 || return 1
  # Legacy fallback (no horneroctl): normalized drawers form directly.
  quickshell ipc call drawers toggle launcher
  return 0
}

minimal_fallback() {
  echo "[dots-launcher] minimal fallback (no GUI launchers found)" >&2
  read -r -p "command> " cmd || exit 1
  [[ -z $cmd ]] && exit 0
  exec $cmd
}

if [[ -z "${HORNEROCTL_DELEGATED:-}" ]]; then
  _horneroctl_bin="${HORNEROCTL_BIN:-horneroctl}"
  if command -v "$_horneroctl_bin" >/dev/null 2>&1; then
    _horneroctl_help="$("$_horneroctl_bin" apps --help 2>/dev/null || true)"
    case "$_horneroctl_help" in
      *"Usage: horneroctl apps"*)
        if [[ $LIST == yes ]]; then
          exec "$_horneroctl_bin" apps launch --list
        elif [[ $BACKEND == auto ]]; then
          exec "$_horneroctl_bin" apps launch
        else
          exec "$_horneroctl_bin" apps launch --backend "$BACKEND"
        fi
        ;;
    esac
  fi
fi

if [[ $LIST == yes ]]; then
  order=(quickshell minimal)
  avail=()
  for t in "${order[@]}"; do
    if [[ $t == minimal ]]; then
      avail+=(minimal)
    elif command -v "$t" >/dev/null 2>&1; then
      avail+=("$t")
    fi
  done
  printf '%s\n' "${avail[@]}"
  exit 0
fi

case "$BACKEND" in
  quickshell) launch_quickshell || {
    echo "quickshell is not running" >&2
    exit 1
  } ;;
  minimal) minimal_fallback ;;
  auto | *)
    launch_quickshell || minimal_fallback
    ;;
esac
