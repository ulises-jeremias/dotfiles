#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Take a screenshot
##
## Usage:
##   @script.name [OPTIONS]
##
## Options:
##   -h, --help         Show this help message
##   -v, --version      Display script version
##   -f, --fullscreen   Take a screenshot of the entire screen
##   -r, --region       Select a region to capture interactively
##
## Delegation: --region runs via `horneroctl capture screenshot --region`
## (HORNEROCTL_BIN override, default horneroctl on PATH) when that
## subcommand exists, else the legacy sss call below. Fullscreen stays
## legacy: it also copies to the clipboard (--copy), which horneroctl
## screenshot does not implement. Skipped under HORNEROCTL_DELEGATED so a
## horneroctl-driven backend call runs the legacy body instead of calling
## back.

source ~/.local/lib/dots/easy-options/easyoptions.sh || exit

set -euo pipefail

shoot() {
	if [ -n "${region:-}" ]; then
		if [[ -z "${HORNEROCTL_DELEGATED:-}" ]]; then
			_horneroctl_bin="${HORNEROCTL_BIN:-horneroctl}"
			if command -v "$_horneroctl_bin" >/dev/null 2>&1; then
				_horneroctl_help="$("$_horneroctl_bin" capture --help 2>/dev/null || true)"
				case "$_horneroctl_help" in
					*"Usage: horneroctl capture"*) exec "$_horneroctl_bin" capture screenshot --region --yes ;;
				esac
			fi
		fi
		sss
	else
		local pictures filename
		pictures="${XDG_PICTURES_DIR:-$HOME/Pictures}"
		filename="${pictures}/screenshot_$(date +%Y%m%d_%H%M%S).png"
		sss --screen --current --copy --output "$filename"
	fi
}

if [[ -n ${version:-} ]]; then
	echo "dots-screenshooter -- Version 0.4"
	exit 0
fi

if [[ -n ${region:-} ]]; then
	region=1
fi

shoot
