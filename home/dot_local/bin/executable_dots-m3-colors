#!/usr/bin/env bash

## Copyright (C) 2019-2026 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## ## Generate M3 (Material You) color palettes from the current wallpaper
##
## Usage:
##     @script.name [OPTION] ARGUMENTS...
## dots-m3-colors: Run generate-m3-colors.py with a Python that has materialyoucolor.
## Prefers /usr/bin/python3 (Arch python-materialyoucolor) over pyenv/asdf PATH shims.

set -euo pipefail

# horneroctl delegation (HORNEROCTL_BIN override, default horneroctl on
# PATH): prefer `horneroctl appearance colors m3` when the subcommand
# exists. Skipped under HORNEROCTL_DELEGATED so a horneroctl-driven backend
# call runs the legacy body below instead of calling back.
if [[ -z "${HORNEROCTL_DELEGATED:-}" ]]; then
	_horneroctl_bin="${HORNEROCTL_BIN:-horneroctl}"
	if command -v "$_horneroctl_bin" >/dev/null 2>&1; then
		_horneroctl_help="$("$_horneroctl_bin" appearance colors --help 2>/dev/null || true)"
		case "$_horneroctl_help" in
		*"appearance colors m3"*)
			exec "$_horneroctl_bin" appearance colors m3 --yes -- "$@"
			;;
		esac
	fi
	unset _horneroctl_bin _horneroctl_help
fi

SCRIPT="${HOME}/.local/lib/dots/generate-m3-colors.py"
[[ -f $SCRIPT ]] || {
	echo "dots-m3-colors: missing $SCRIPT" >&2
	exit 1
}

_dots_m3_python() {
	if [[ -x /usr/bin/python3 ]] && /usr/bin/python3 -c 'import materialyoucolor' >/dev/null 2>&1; then
		printf '%s\n' /usr/bin/python3
		return 0
	fi
	if command -v python3 >/dev/null 2>&1 && python3 -c 'import materialyoucolor' >/dev/null 2>&1; then
		command -v python3
		return 0
	fi
	return 1
}

py="$(_dots_m3_python)" || {
	echo "dots-m3-colors: materialyoucolor not found." >&2
	echo "  Arch: yay -S --needed python-materialyoucolor" >&2
	echo "  Or install materialyoucolor into the Python that wins on PATH." >&2
	exit 1
}

exec "$py" "$SCRIPT" "$@"
