#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Animation profile manager for Hyprland.
## Applies the orphaned animation profiles from
## hyprland.conf.d/animations-<profile>.conf live via hyprctl keywords.
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Usage:
##     @script.name [OPTIONS]
##
## Options:
##     -h, --help              Show this help message
##         --set=PROFILE       Apply an animation profile (default|cozy|cyberpunk|nature|minimal|vaporwave)
##         --next              Cycle to the next profile
##         --current           Print the active profile
##         --list              List available profiles
##         --restore           Restore persisted profile from state file
##         --ephemeral         Do not persist the selection to disk
##         --quiet             Disable desktop notifications
##
## Delegation: every verb runs via `horneroctl hypr animations` when that
## subcommand exists (HORNEROCTL_BIN override, default horneroctl on
## PATH), else the legacy hyprctl/state implementation below. No cycle
## risk: `horneroctl hypr animations` never calls back into this script
## (pure hyprctl keywords + state files). An explicit --set/--next/
## --restore is the confirmation, so --yes is passed outward; --ephemeral
## is passed through; --quiet needs no forwarding (horneroctl never
## sends desktop notifications).

set -euo pipefail

source ~/.local/lib/dots/easy-options/easyoptions.sh || exit

readonly CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf.d"
readonly STATE_DIR="${HOME}/.local/state/dots/hypr-animations"
readonly STATE_FILE="${STATE_DIR}/current"
readonly DEFAULT_PROFILE="default"
readonly PROFILES=(default cozy cyberpunk nature minimal vaporwave)

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

# Prefer `horneroctl hypr animations` when that subcommand exists;
# otherwise run the legacy implementation kept in this file.
USE_HORNERO_ANIMATIONS=0
if command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
  && "$HORNEROCTL_BIN" hypr animations --help >/dev/null 2>&1; then
  USE_HORNERO_ANIMATIONS=1
fi

# Run one animations verb via horneroctl (list/current are reads; the
# explicit set/next/restore flag is the confirmation, so --yes is passed).
hornero_animations() {
  local leaf="$1"
  local profile="${2:-}"
  local args=(hypr animations "$leaf")
  if [[ $leaf == set ]]; then
    args+=("$profile")
  fi
  if [[ ${ephemeral:-no} == yes ]]; then
    args+=(--ephemeral)
  fi
  case "$leaf" in
    list | current) ;;
    *) args+=(--yes) ;;
  esac
  "$HORNEROCTL_BIN" "${args[@]}"
}

notify_profile() {
  local message="$1"

  if [[ ${quiet:-no} == yes ]]; then
    return 0
  fi

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u low -i preferences-desktop "Hyprland Animations" "$message" || true
  fi
}

is_valid_profile() {
  local candidate="$1"
  local profile

  for profile in "${PROFILES[@]}"; do
    [[ $candidate == "$profile" ]] && return 0
  done
  return 1
}

ensure_hyprctl() {
  if ! command -v hyprctl >/dev/null 2>&1; then
    echo "[ERROR] hyprctl not found. This command requires Hyprland." >&2
    return 1
  fi
}

profile_conf() {
  local profile="$1"

  if [[ $profile == "$DEFAULT_PROFILE" ]]; then
    printf '%s\n' "${CONF_DIR}/animations.conf"
  else
    printf '%s\n' "${CONF_DIR}/animations-${profile}.conf"
  fi
}

current_profile() {
  local value=""

  if [[ -f $STATE_FILE ]]; then
    value="$(awk 'NF {print $1; exit}' "$STATE_FILE")"
  fi

  if ! is_valid_profile "$value"; then
    value="$DEFAULT_PROFILE"
  fi

  printf '%s\n' "$value"
}

save_state() {
  local profile="$1"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$profile" >"$STATE_FILE"
}

apply_profile() {
  local profile="$1"
  local conf
  conf="$(profile_conf "$profile")"

  if [[ ! -f $conf ]]; then
    echo "[ERROR] Profile config not found: ${conf}" >&2
    return 1
  fi

  # Beziers must be defined before the animations that reference them.
  while IFS= read -r line; do
    hyprctl keyword bezier "$line" >/dev/null
  done < <(awk '/^[[:space:]]*bezier = /{sub(/^[[:space:]]*bezier =[[:space:]]*/, ""); print}' "$conf")

  while IFS= read -r line; do
    hyprctl keyword animation "$line" >/dev/null
  done < <(awk '/^[[:space:]]*animation = /{sub(/^[[:space:]]*animation =[[:space:]]*/, ""); print}' "$conf")
}

next_profile() {
  local current
  current="$(current_profile)"
  local total=${#PROFILES[@]}
  local index=0
  local i

  for ((i = 0; i < total; i++)); do
    if [[ ${PROFILES[$i]} == "$current" ]]; then
      index=$i
      break
    fi
  done

  printf '%s\n' "${PROFILES[$(( (index + 1) % total ))]}"
}

set_profile() {
  local profile="$1"

  if ! is_valid_profile "$profile"; then
    echo "[ERROR] Unsupported profile: ${profile}" >&2
    echo "Available: ${PROFILES[*]}" >&2
    return 1
  fi

  ensure_hyprctl

  apply_profile "$profile"

  if [[ ${ephemeral:-no} != yes ]]; then
    save_state "$profile"
  fi

  notify_profile "Switched to ${profile} animations"
}

usage_examples() {
  cat <<EOF
Examples:
  dots hypr-animations --set=cozy     # slow, smooth, bouncy
  dots hypr-animations --next         # cycle profiles
  dots hypr-animations --current      # print active profile
  dots hypr-animations --restore      # re-apply after reload
EOF
}

main() {
  local command=""

  [[ ${set:-} != "" ]] && command="set"
  [[ ${next:-no} == yes ]] && command="next"
  [[ ${current:-no} == yes ]] && command="current"
  [[ ${list:-no} == yes ]] && command="list"
  [[ ${restore:-no} == yes ]] && command="restore"

  case "$command" in
    set | next | current | list | restore)
      if ((USE_HORNERO_ANIMATIONS)); then
        case "$command" in
          set) hornero_animations set "$set" ;;
          next) hornero_animations next ;;
          current) hornero_animations current ;;
          list) hornero_animations list ;;
          restore) hornero_animations restore ;;
        esac
        return
      fi
      ;;
  esac

  case "$command" in
    set)
      set_profile "$set"
      ;;
    next)
      set_profile "$(next_profile)"
      ;;
    current)
      current_profile
      ;;
    list)
      printf '%s\n' "${PROFILES[@]}"
      ;;
    restore)
      ensure_hyprctl
      set_profile "$(current_profile)"
      ;;
    "")
      echo "No command specified. Use --help for usage." >&2
      usage_examples
      exit 1
      ;;
    *)
      echo "Unknown command combination." >&2
      usage_examples
      exit 1
      ;;
  esac
}

main "$@"
