#!/usr/bin/env bash

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
##     @script.name [OPTION] ARGUMENTS...
##
## Check full documentation at: https://github.com/ulises-jeremias/dotfiles/wiki
##
## Show a menu to manage monitor configuration in Hyprland
##
## Delegation: the interactive menu below is this script's UI (horneroctl
## has no menu); once an arrangement is picked, it is applied via
## `horneroctl hypr monitors set <mode> --yes` when that subcommand
## exists (HORNEROCTL_BIN override, default horneroctl on PATH), else the
## legacy hyprctl calls in the case statement. No cycle risk: horneroctl
## never calls back into this script (pure hyprctl keywords). The menu
## choice is the confirmation, so --yes is passed outward.

set -euo pipefail

HORNEROCTL_BIN="${HORNEROCTL_BIN:-horneroctl}"

# Prefer `horneroctl hypr monitors set` when that subcommand exists;
# otherwise run the legacy hyprctl calls kept in the case statement.
USE_HORNERO_MONITORS=0
if command -v "$HORNEROCTL_BIN" >/dev/null 2>&1 \
  && "$HORNEROCTL_BIN" hypr monitors --help >/dev/null 2>&1; then
  USE_HORNERO_MONITORS=1
fi

# Map a menu selection to a horneroctl monitor mode (empty = a monitor
# line, which applies nothing, mirroring the legacy fall-through).
mon_mode_for_selection() {
  case "$1" in
    "󰍺 Internal Only") printf 'internal-only' ;;
    "󰍹 External Only") printf 'external-only' ;;
    "󰹑 Extend Right") printf 'extend-right' ;;
    "󰹑 Extend Left") printf 'extend-left' ;;
    "󰹑 Extend Above") printf 'extend-above' ;;
    "󰹑 Extend Below") printf 'extend-below' ;;
    "󰍷 Mirror Displays") printf 'mirror' ;;
    "󰑊 Disable All External") printf 'disable-external' ;;
  esac
  return 0
}

if [[ ${DOTS_BYPASS_QUICKSHELL:-0} != 1 ]] && pgrep -x quickshell >/dev/null 2>&1; then
  dots-settings-gui --pane=system menu
  exit 0
fi

if ! command -v hyprctl >/dev/null 2>&1; then
  echo "Command not found: hyprctl. This script requires Hyprland."
  notify-send "$0: Command not found: hyprctl. This script requires Hyprland." -u critical
  exit 1
fi

# Get monitor information
get_monitors() {
  hyprctl monitors -j | jq -r '.[] | "\(.name)|\(.width)x\(.height)@\(.refreshRate)|\(.transform)|\(.scale)"'
}

# List available monitors
list_monitors() {
  while IFS='|' read -r name resolution transform scale; do
    echo "󰍹 $name - $resolution (Scale: $scale)"
  done < <(get_monitors)
}

# Print menu options
print_menu() {
  echo "󰍺 Internal Only"
  echo "󰍹 External Only"
  echo "󰹑 Extend Right"
  echo "󰹑 Extend Left"
  echo "󰹑 Extend Above"
  echo "󰹑 Extend Below"
  echo "󰍷 Mirror Displays"
  echo "󰑊 Disable All External"
  echo "──────────────"
  list_monitors
}

# Get internal and external monitors
internal=$(hyprctl monitors -j | jq -r '.[] | select(.name | startswith("eDP")) | .name' | head -n 1)
external=$(hyprctl monitors -j | jq -r '.[] | select(.name | startswith("eDP") | not) | .name' | head -n 1)

# Fallback if naming convention doesn't match
if [ -z "$internal" ]; then
  internal=$(hyprctl monitors -j | jq -r '.[0].name')
fi

if [ -z "$external" ]; then
  # Get second monitor if available
  external=$(hyprctl monitors -j | jq -r '.[1].name // empty')
fi

# Execute monitor configuration (terminal selector)
mapfile -t monitor_options < <(print_menu)
echo "Monitor Setup"
i=1
for opt in "${monitor_options[@]}"; do
  printf "%2d) %s\n" "$i" "$opt"
  i=$((i + 1))
done
printf "Choice [1-%d, empty to cancel]: " "${#monitor_options[@]}"
read -r idx || exit 1
[[ -z ${idx:-} ]] && exit 0
[[ "$idx" =~ ^[0-9]+$ ]] || exit 1
(( idx >= 1 && idx <= ${#monitor_options[@]} )) || exit 1
selection="${monitor_options[$((idx - 1))]}"

# Delegate arrangement picks to horneroctl when available; a monitor line
# (empty mode) falls through to the legacy no-op, exactly as before.
mode="$(mon_mode_for_selection "$selection")"
if [[ -n $mode && $USE_HORNERO_MONITORS == 1 ]]; then
  "$HORNEROCTL_BIN" hypr monitors set "$mode" --yes
  notify-send "Monitor Configuration" "Applied successfully" -i video-display
  exit 0
fi

case "$selection" in
  "󰍺 Internal Only") # Internal Only
    if [ -n "$external" ]; then
      hyprctl keyword monitor "$external,disable"
    fi
    hyprctl keyword monitor "$internal,preferred,auto,1"
    ;;
  "󰍹 External Only") # External Only
    if [ -n "$external" ]; then
      hyprctl keyword monitor "$internal,disable"
      hyprctl keyword monitor "$external,preferred,auto,1"
    fi
    ;;
  "󰹑 Extend Right") # Extend Right
    if [ -n "$external" ]; then
      internal_width=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$internal\") | .width")
      hyprctl keyword monitor "$internal,preferred,0x0,1"
      hyprctl keyword monitor "$external,preferred,${internal_width}x0,1"
    fi
    ;;
  "󰹑 Extend Left") # Extend Left
    if [ -n "$external" ]; then
      external_width=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$external\") | .width")
      hyprctl keyword monitor "$external,preferred,0x0,1"
      hyprctl keyword monitor "$internal,preferred,${external_width}x0,1"
    fi
    ;;
  "󰹑 Extend Above") # Extend Above
    if [ -n "$external" ]; then
      external_height=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$external\") | .height")
      hyprctl keyword monitor "$external,preferred,0x0,1"
      hyprctl keyword monitor "$internal,preferred,0x${external_height},1"
    fi
    ;;
  "󰹑 Extend Below") # Extend Below
    if [ -n "$external" ]; then
      internal_height=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$internal\") | .height")
      hyprctl keyword monitor "$internal,preferred,0x0,1"
      hyprctl keyword monitor "$external,preferred,0x${internal_height},1"
    fi
    ;;
  "󰍷 Mirror Displays") # Mirror
    if [ -n "$external" ]; then
      hyprctl keyword monitor "$internal,preferred,0x0,1,mirror,$external"
    fi
    ;;
  "󰑊 Disable All External") # Disable All External
    hyprctl monitors -j | jq -r '.[] | select(.name | startswith("eDP") | not) | .name' | while read -r mon; do
      hyprctl keyword monitor "$mon,disable"
    done
    ;;
esac

notify-send "Monitor Configuration" "Applied successfully" -i video-display
