#!/usr/bin/env bash

## Copyright (C) 2019-2026 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## Unified wallpaper entrypoint — IPC stub for Quickshell ThemePipeline.
## When Quickshell is running, delegates to appearance.setWallpaper via IPC.
## Falls back to wal + M3 + state sync when QS is not running.

set -euo pipefail

WALLPAPER_INPUT="${1:-}"
if [[ -z $WALLPAPER_INPUT ]]; then
	echo "Usage: $0 <wallpaper_path>" >&2
	exit 1
fi

WALLPAPER_PATH="$(readlink -f "$WALLPAPER_INPUT" 2>/dev/null || true)"
if [[ -z ${WALLPAPER_PATH:-} || ! -f $WALLPAPER_PATH ]]; then
	echo "Error: wallpaper file not found: $WALLPAPER_INPUT" >&2
	exit 1
fi

_wait_appearance_ipc() {
	local _i busy="" last_error
	for _i in $(seq 1 120); do
		if ! busy="$(quickshell ipc call appearance isBusy 2>/dev/null)"; then
			return 1
		fi
		busy="${busy//$'\r'/}"
		busy="${busy//$'\n'/}"
		[[ $busy == "1" ]] || break
		sleep 0.5
	done
	[[ $busy == "1" ]] && return 1
	last_error="$(quickshell ipc call appearance lastError 2>/dev/null || true)"
	last_error="${last_error//$'\r'/}"
	last_error="${last_error//$'\n'/}"
	[[ -n $last_error ]] && return 1
	return 0
}

if pgrep -x quickshell >/dev/null 2>&1; then
	ipc_out=""
	if ipc_out="$(quickshell ipc call appearance setWallpaper "$WALLPAPER_PATH" 2>&1)"; then
		case "$ipc_out" in
		"Target not found."* | *"Target not found"*)
			echo "Warning: Quickshell IPC unavailable ($ipc_out); falling back to direct apply" >&2
			;;
		*)
			_wait_appearance_ipc || {
				echo "Error: appearance wallpaper apply failed" >&2
				exit 1
			}
			exit 0
			;;
		esac
	else
		echo "Warning: Quickshell IPC failed; falling back to direct apply" >&2
	fi
fi

# shellcheck source=/dev/null
source "$HOME/.local/lib/dots/wallpaper-resolver.sh" 2>/dev/null || true
# shellcheck source=/dev/null
source "$HOME/.local/lib/dots/apply-appearance.sh"

dots_apply_wallpaper_only "$WALLPAPER_PATH"
