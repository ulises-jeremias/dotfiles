{{- if not .personal -}}
.ssh/*
.config/credentials/*
{{- end -}}

{{- if ne .chezmoi.os "linux" -}}
.chezmoiscripts/linux/**
.clamtk/**
{{- end -}}

{{- if eq .chezmoi.os "linux" -}}
{{-   if or (.ephemeral) (.headless) -}}
.clamtk/**
.config/alacrity/**
.config/fontconfig/**
.config/i3/**
.config/openbox/**
.config/polybar/**
.config/xfce4/**
.config/picom.conf
{{-   end -}}

# XFCE configs - Only manage helpers.rc for exo-open, ignore xfconf
.config/xfce4/xfconf/**

# LXQt - Only manage minimal required configs
# Ignore window geometry and UI state files
.config/lxqt/lxqt-config-appearance.conf
.config/lxqt/lxqt-config.conf
.config/lxqt/lxqt-config-locale.conf
.config/lxqt/lxqt-config-monitor.conf
.config/lxqt/session.conf

# The hornero-shell AUR package owns the product runtime under /etc/xdg.
# Leave any local Quickshell checkout untouched; horneroctl explicitly selects
# the packaged `hornero` config unless the user requests an override.
.config/quickshell/**

# Temporary and cache directories
.cache/**
.local/state/**

{{- end -}}
