{{- if not .personal -}}
.ssh/*
.config/credentials/*
{{- end -}}

{{- if ne .chezmoi.os "linux" -}}
.chezmoiscripts/linux/**
.clamtk/**
{{- end -}}

{{- if eq .chezmoi.os "linux" -}}
{{-   if or (.ephemeral) (.headless) -}}
.clamtk/**
.config/alacrity/**
.config/fontconfig/**
.config/i3/**
.config/openbox/**
.config/polybar/**
.config/wpg/**
.config/xfce4/**
.config/picom.conf
{{-   end -}}

# XFCE configs - Only manage helpers.rc for exo-open, ignore xfconf
.config/xfce4/xfconf/**

# LXQt - Only manage minimal required configs
# Ignore window geometry and UI state files
.config/lxqt/lxqt-config-appearance.conf
.config/lxqt/lxqt-config.conf
.config/lxqt/lxqt-config-locale.conf
.config/lxqt/lxqt-config-monitor.conf
.config/lxqt/session.conf

# Hornero shell contract (HorneroOS/hornero#81, option C):
# HorneroOS/shell is the authoritative product implementation and the
# installed ~/.config/quickshell tree is the runtime. chezmoi must never
# manage, overwrite, or delete anything under it — a normal apply cannot
# silently downgrade the installed shell. Personal overrides: none today;
# if any are ever needed, add explicit un-ignore lines below this block.
.config/quickshell/**

# Temporary and cache directories
.cache/**
.local/state/**

{{- end -}}
