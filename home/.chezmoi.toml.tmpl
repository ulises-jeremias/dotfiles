{{- $interactive := stdinIsATTY -}}

{{/* boolean feature tags */}}
{{- $docker := false -}}{{/* true if this machine should have Docker installed */}}
{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g. a cloud or VM instance */}}
{{- $headless := false -}}{{/* true if this machine does not have a screen and keyboard */}}
{{- $personal := false -}}{{/* true if this machine should have personal secrets */}}
{{- $e2e := false -}}{{/* true if this is the E2E test VM (full desktop, no secrets, no prompts) */}}
{{- if env "HORNERO_E2E" -}}
{{-   $e2e = true -}}
{{- end -}}
{{- "" -}}

{{- $osid := .chezmoi.os -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* detect Gitconfig codespaces, VSCode remote containers, Docker containers, Multipass VMs, and Vagrant boxes */}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode") -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- end -}}

{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $computerName := output "scutil" "--get" "ComputerName" | trim -}}
{{-   if eq $computerName "Uli’s MacBook Air" -}}
{{-     $hostname = "ulis-mba" -}}
{{-   else -}}
{{-     $hostname = $computerName -}}
{{-   end -}}
{{- end -}}

{{- if eq .chezmoi.os "windows" -}}
{{-   $ephemeral = true -}}
{{- end -}}

{{- if $e2e -}}
{{/* E2E VM: full desktop install like a real machine, but never personal
     (LastPass/SSH secrets stay out) and never interactive. */}}
{{-   $ephemeral = false -}}
{{-   $headless = false -}}
{{- else if not $ephemeral -}}
{{-   if or (eq $hostname "hornero") (eq $hostname "colibri") -}}
{{-     $personal = true -}}
{{-     $docker = true -}}
{{-   else if eq $hostname "pelicano" -}}
{{/* pelicano is the HorneroOS Studio production/streaming laptop:
     personal, but Docker and background services stay opt-in so the
     event machine runs nothing it does not need. */}}
{{-     $personal = true -}}
{{-     $docker = false -}}
{{-   else if $interactive -}}
{{-     $headless = promptBoolOnce . "headless" "headless" -}}
{{-     $ephemeral = promptBoolOnce . "ephemeral" "ephemeral" -}}
{{-     if not $ephemeral -}}
{{-       $docker = promptBoolOnce . "docker" "docker" -}}
{{-     end -}}
{{-   else -}}
{{-     $ephemeral = true -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}

{{- $userName := "" -}}
{{- $userEmail := "" -}}
{{- if $interactive -}}
{{-   $userName = promptStringOnce . "userName" "What is your full name" -}}
{{-   $userEmail = promptStringOnce . "userEmail" "What is your personal email account" -}}
{{- end -}}

{{- $gitUserName := "" -}}
{{- $gitUserEmail := "" -}}
{{- if $interactive -}}
{{-   $gitUserName = promptStringOnce . "gitUserName" "What is the name you use for git" -}}
{{-   $gitUserEmail = promptStringOnce . "gitUserEmail" "What is the email you use for git" -}}
{{- end -}}

{{/* Native HorneroOS detection: the distribution owns Shell, Config,
     Greeter, drivers, PipeWire and Studio there. True when the OS
     identity says so, or when the maintainer opts in explicitly with
     HORNERO_NATIVE=1 for an install the identity cannot yet prove. */}}
{{- $horneroNative := false -}}
{{- if and (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "horneroos") -}}
{{-   $horneroNative = true -}}
{{- end -}}
{{- if eq (env "HORNERO_NATIVE") "1" -}}
{{-   $horneroNative = true -}}
{{- end -}}

[data]
    docker = {{ $docker }}
    horneroNative = {{ $horneroNative }}
    e2e = {{ $e2e }}
    ephemeral = {{ $ephemeral }}
    headless = {{ $headless }}
    hostname = {{ $hostname | quote }}
    osid = {{ $osid | quote }}
    personal = {{ $personal }}

[data.profile.user]
    name = {{ $userName | quote }}
    email = {{ $userEmail | quote }}

[data.gitconfig.user]
    name = {{ $gitUserName | quote }}
    email = {{ $gitUserEmail | quote }}
