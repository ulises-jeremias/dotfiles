{"api_version":"hornero.os/v1","kind":"WorkspaceProfileBundle","portable":true,"profile":{"api_version":"hornero.os/v1","kind":"WorkspaceProfile","id":"guitarra-discord-llamada","name":"Guitarra + Discord (Llamada)","description":"REAPER (8 tonos NAM + Avenged Lead) + qpwgraph + Discord Lesson Mic + Zen Browser Backing","hostname":"","created_at":"2026-11-27T22:26:56Z","updated_at":"2026-11-27T22:26:56Z","domains":["experience","audio","power","extensions","apps"],"experience":{"mode":"everyday","theme":"hornero-chromatic","layout_preset":"hornero-left"},"audio":{"studio_audio_mode":"advanced","clock_rate":"48000","clock_quantum":"256","clock_min_quantum":"64","clock_max_quantum":"1024","default_sink":"alsa_output.pci-0000_80_1f.3.analog-stereo","default_sink_desc":"800 Series Chipset Family Audio Context Engine (ACE) Analog Stereo","default_source":"alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_T23KTXD3603210-00.HiFi__Mic1__source","default_source_desc":"Scarlett 2i2 4th Gen Input 1 Mic/Inst/Line","pipewire_dropins":["10-guitar-lesson.conf","60-reaper-music-studio.conf","65-browser-backing.conf"],"jack_dropins":["60-reaper-low-latency.conf"],"links":["REAPER:out1 -> alsa_output.pci-0000_80_1f.3.analog-stereo:playback_FL","REAPER:out2 -> alsa_output.pci-0000_80_1f.3.analog-stereo:playback_FR","REAPER:out3 -> reaper_lesson.input:input_FL","REAPER:out4 -> reaper_lesson.input:input_FR","REAPER:out5 -> reaper_program.input:input_FL","REAPER:out6 -> reaper_program.input:input_FR","Zen:output_FL -> browser_backing:playback_FL","Zen:output_FR -> browser_backing:playback_FR","alsa_input.hw_Gen_0:capture_AUX0 -> REAPER:in1","alsa_input.hw_Gen_0:capture_AUX0 -> alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_T23KTXD3603210-00.HiFi__Mic1__source.split:input_AUX0","alsa_input.hw_Gen_0:capture_AUX1 -> REAPER:in2","alsa_input.hw_Gen_0:capture_AUX1 -> alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_T23KTXD3603210-00.HiFi__Mic2__source.split:input_AUX1","alsa_input.hw_Gen_0:capture_AUX2 -> alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_T23KTXD3603210-00.HiFi__Line2__source.split:input_AUX2","alsa_input.hw_Gen_0:capture_AUX3 -> alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_T23KTXD3603210-00.HiFi__Line2__source.split:input_AUX3","alsa_output.pci-0000_80_1f.3.analog-stereo:monitor_FL -> hornero-shell:input_FL","alsa_output.pci-0000_80_1f.3.analog-stereo:monitor_FR -> hornero-shell:input_FR","browser_backing.output:output_FL -> REAPER:in3","browser_backing.output:output_FR -> REAPER:in4","discord_call.output:output_FL -> alsa_output.pci-0000_80_1f.3.analog-stereo:playback_FL","discord_call.output:output_FR -> alsa_output.pci-0000_80_1f.3.analog-stereo:playback_FR"],"stream_routes":[{"app":"discord_call.output","sink":"alsa_output.pci-0000_80_1f.3.analog-stereo"},{"app":"browser_backing.output","sink":"4294967295"},{"app":"Zen","sink":"browser_backing"}],"qpwgraph_patchbay":"{{ .chezmoi.homeDir }}/.config/qpwgraph/music-studio.qpwgraph"},"power":{"profile":"balanced","idle_inhibitor":false},"extensions":{"enabled":["hornero-ai-usage","hornero-audio-deck","hornero-bitin","hornero-capi","hornero-clipboard","hornero-containers","hornero-elsewhen","hornero-github-stats","hornero-metronome","hornero-microphone","hornero-pomodoro","hornero-quick-notes","hornero-studio-audio","hornero-tailscale","hornero-uptime","hornero-volume","hornero-weather"]},"apps":[{"id":"discord","name":"Discord","exec":["discord"],"process_match":"discord","category":"comms"},{"id":"kitty","name":"Kitty","exec":["kitty"],"process_match":"kitty","category":"dev"},{"id":"qpwgraph","name":"qpwgraph","exec":["qpwgraph"],"process_match":"qpwgraph","category":"audio"},{"id":"reaper","name":"REAPER","exec":["reaper"],"process_match":"reaper","category":"audio"},{"id":"zen-browser","name":"Zen Browser","exec":["zen-browser"],"process_match":"zen","category":"browser"}]},"pipewire_dropin_files":{"10-guitar-lesson.conf":"# Guitar lesson low-latency defaults (user-level, shipped with dots-guitar-lesson).\n# Takes effect on next PipeWire start; `dots-guitar-lesson start` also forces the\n# quantum at runtime so a restart is not required. Delete this file and run\n# `systemctl --user restart pipewire wireplumber` to fully revert.\ncontext.properties = {\n    default.clock.rate          = 48000\n    default.clock.allowed-rates = [ 48000 44100 ]\n    default.clock.quantum       = 256\n    default.clock.min-quantum   = 64\n    default.clock.max-quantum   = 1024\n}\n","60-reaper-music-studio.conf":"# REAPER music studio: permanent virtual audio endpoints (docs/REAPER-Vocal-Studio.md).\n#\n#   REAPER out 3-4 -> \"REAPER Lesson Bus input\" -> \"REAPER Lesson Mic\"  (Discord input)\n#   REAPER out 5-6 -> \"REAPER Program input\"    -> \"REAPER Program\"     (OBS capture)\n#   Discord output -> \"Discord Call\" (sink)     -> default output       (+ OBS capture)\n#\n# The REAPER links are made by the qpwgraph patchbay\n# (~/.config/qpwgraph/music-studio.qpwgraph), not by these modules: the bus\n# inputs never auto-connect, so nothing but REAPER can reach the lesson mic.\n# These nodes do not change PipeWire's clock, quantum or default devices\n# (priority.session = 0 keeps them from ever becoming the default).\n# audio.position must sit on each side (capture and playback): set only on the\n# module, the virtual source got no output ports and nothing could record it.\n#\n# Loaded when PipeWire starts. Rollback: delete this file, then\n#   systemctl --user restart pipewire pipewire-pulse wireplumber\ncontext.modules = [\n  { name = libpipewire-module-loopback\n    args = {\n      node.description = \"REAPER Lesson Mic\"\n      capture.props = {\n        node.name          = \"reaper_lesson.input\"\n        node.description   = \"REAPER Lesson Bus input\"\n        node.autoconnect   = false\n        node.dont-reconnect = true\n        stream.dont-remix  = true\n        audio.position     = [ FL FR ]\n      }\n      playback.props = {\n        node.name        = \"reaper_lesson_mic\"\n        node.description = \"REAPER Lesson Mic\"\n        media.class      = \"Audio/Source\"\n        audio.position   = [ FL FR ]\n        priority.session = 0\n        priority.driver  = 0\n      }\n    }\n  }\n  { name = libpipewire-module-loopback\n    args = {\n      node.description = \"REAPER Program\"\n      capture.props = {\n        node.name          = \"reaper_program.input\"\n        node.description   = \"REAPER Program input\"\n        node.autoconnect   = false\n        node.dont-reconnect = true\n        stream.dont-remix  = true\n        audio.position     = [ FL FR ]\n      }\n      playback.props = {\n        node.name        = \"reaper_program\"\n        node.description = \"REAPER Program\"\n        media.class      = \"Audio/Source\"\n        audio.position   = [ FL FR ]\n        priority.session = 0\n        priority.driver  = 0\n      }\n    }\n  }\n  { name = libpipewire-module-loopback\n    args = {\n      node.description = \"Discord Call\"\n      capture.props = {\n        node.name        = \"discord_call\"\n        node.description = \"Discord Call\"\n        media.class      = \"Audio/Sink\"\n        audio.position   = [ FL FR ]\n        priority.session = 0\n        priority.driver  = 0\n      }\n      playback.props = {\n        node.name        = \"discord_call.output\"\n        node.description = \"Discord Call to headphones\"\n        # follows the default output device (your headphones)\n        audio.position   = [ FL FR ]\n      }\n    }\n  }\n]\n","65-browser-backing.conf":"# Browser backing track virtual sink (Zen Browser -> REAPER in3/in4).\n#\n#   Zen Browser (select \"Browser Backing\" in pavucontrol / volume mixer)\n#     -> browser_backing (Audio/Sink) -> browser_backing.output\n#     -> qpwgraph patchbay -> REAPER:in3/in4 -> \"Zen Browser (Backing)\" track\n#\n# Never becomes the default sink (priority.session = 0) and its output never\n# auto-connects, so audio only reaches REAPER and never doubles into speakers.\n# Loaded when PipeWire starts. Rollback: delete this file and restart PipeWire.\ncontext.modules = [\n  { name = libpipewire-module-loopback\n    args = {\n      node.description = \"Browser Backing (Zen -> REAPER)\"\n      capture.props = {\n        node.name        = \"browser_backing\"\n        node.description = \"Browser Backing (Zen -> REAPER)\"\n        media.class      = \"Audio/Sink\"\n        audio.position   = [ FL FR ]\n        priority.session = 0\n        priority.driver  = 0\n      }\n      playback.props = {\n        node.name           = \"browser_backing.output\"\n        node.description    = \"Browser Backing output\"\n        node.autoconnect    = false\n        node.dont-reconnect = true\n        stream.dont-remix   = true\n        audio.position      = [ FL FR ]\n      }\n    }\n  }\n]\n"},"jack_dropin_files":{"60-reaper-low-latency.conf":"# REAPER only: ask for a 256-frame period (5.3 ms at 48 kHz, 8 ms measured\n# output latency) instead of PipeWire's default 1024. Read by the JACK client\n# library when REAPER starts, so it applies however REAPER is launched and does\n# not change PipeWire's defaults. While REAPER runs, the shared graph runs at\n# this period for every client; when REAPER closes it returns to the default.\n# If your hardware xruns, change 256 to 512. Rollback: delete this file.\njack.rules = [\n  { matches = [ { application.process.binary = \"reaper\" } ]\n    actions = { update-props = { node.latency = 256/48000 } }\n  }\n]\n"}}
