// HorneroOS fastfetch card: pixel emblem variant (maintainer choice 2026-11-19).
//
// Logo: the pixel hornero emblem as a kitty image with a transparent disc
// (hornero-emblem.png, generated from art/hornero-nest.svg), so the card
// looks good on dark and light terminals alike. Kitty/Ghostty/WezTerm show
// the image; other terminals fall back to no logo.
// Text keeps the classic framed card: HORNERO OS title, palette strip,
// section tree. Synced with HorneroOS/config by hand — see docs/FASTFETCH.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/hornero-emblem.png",
    "type": "kitty",
    "width": 34,
    "height": 17,
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": " -> ",
    "constants": [
      "──────────────────────────────"
    ]
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌{$1}{$1}┐",
      "outputColor": "90"
    },
    {
      "type": "title",
      "keyWidth": 10,
      "format": "{#38;2;240;139;67}HORNERO OS{#} · 🚀 {user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "└{$1}{$1}┘",
      "outputColor": "90"
    },
    {
      "type": "custom",
      "format": " {#31}  {#33}  {#32}  {#36}  {#34}  {#35}  {#37}  {#97} "
    },
    {
      "type": "custom",
      "format": "┌{$1}{$1}┐",
      "outputColor": "90"
    },
    {
      "type": "os",
      "key": "{icon} OS",
      "keyColor": "yellow",
      "format": "HorneroOS {build-id}"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": "│ ├󰧨",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "wallpaper",
      "key": "│ └󰸉",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰑭",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ └󰍹",
      "keyColor": "green"
    },
    {
      "type": "sound",
      "key": " SND",
      "keyColor": "cyan"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "cyan"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "└{$1}{$1}┘",
      "outputColor": "90"
    },
    "break",
    {
      "type": "custom",
      "format": " {#31}  {#33}  {#32}  {#36}  {#34}  {#35}  {#37}  {#97} "
    }
  ]
}
