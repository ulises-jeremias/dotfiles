// HorneroOS fastfetch card: Signal Bezel Calido.
//
// Colours are terminal palette ROLES only (never RGB), so the card follows the
// applied Signal theme (Night, Day, Dusk, Contrast) and Hornero Chromatic:
//   33 amber = signal / plumage    90 slate = labels and frames
//   31 red, 32 green, 34 blue, 35 rose, 36 cyan = the palette strip, which is
//   the live wallpaper-derived palette when Chromatic is active.
// Keys are plain ASCII (no Nerd Font glyphs) so the card renders in any font.
//
// HorneroOS rows (ID, EDITION, MODE, THEME, CHROMA, BUILD) come from
// `hornero-fetch fact <name>`: local state files only, a few ms, hidden when a
// value is unknown. ID (user@host) stays empty unless you opt in with
// `identity=1` in ~/.config/hornero/fastfetch.conf or HORNERO_FETCH_IDENTITY=1.
// Run the card through `hornero-fetch` for terminal-aware logo selection
// (full art, compact art, image, none) and the override file; see
// docs/FASTFETCH.md. This file is the stock fastfetch config: copy it to
// ~/.config/fastfetch/config.jsonc to take full control.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/hornero.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "90"
    },
    "constants": [
      "──────────────────────────────",
      "────────────────────────────"
    ],
    "percent": {
      "type": 3,
      "green": 32,
      "yellow": 33,
      "red": 31
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "width": 8,
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "90"
      }
    }
  },
  "modules": [
    {
      "type": "command",
      "key": "▌ ",
      "keyColor": "33",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact banner 2>/dev/null || printf 'HORNERO OS'"
    },
    {
      "type": "command",
      "key": "  ID       ",
      "keyColor": "90",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact identity 2>/dev/null"
    },
    {
      "type": "command",
      "key": "  EDITION  ",
      "keyColor": "90",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact edition 2>/dev/null"
    },
    {
      "type": "command",
      "key": "  MODE     ",
      "keyColor": "90",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact mode 2>/dev/null"
    },
    {
      "type": "command",
      "key": "  THEME    ",
      "keyColor": "90",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact theme 2>/dev/null"
    },
    {
      "type": "command",
      "key": "  CHROMA   ",
      "keyColor": "90",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact chroma 2>/dev/null"
    },
    {
      "type": "command",
      "key": "  BUILD    ",
      "keyColor": "90",
      "text": "f=$(command -v hornero-fetch || echo /usr/share/hornero/bin/hornero-fetch); \"$f\" fact build 2>/dev/null"
    },
    {
      "type": "custom",
      "format": "{#33}▌{#0} {#1}SYSTEM{#0} {#90}{$1}"
    },
    {
      "type": "kernel",
      "key": "  KERNEL   ",
      "keyColor": "90",
      "format": "{sysname} {release}"
    },
    {
      "type": "uptime",
      "key": "  UPTIME   ",
      "keyColor": "90",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "packages",
      "key": "  PACKAGES ",
      "keyColor": "90",
      "format": "{pacman} pacman{?flatpak-all} · {flatpak-all} flatpak{?}"
    },
    {
      "type": "shell",
      "key": "  SHELL    ",
      "keyColor": "90",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "  WM       ",
      "keyColor": "90"
    },
    {
      "type": "terminal",
      "key": "  TERMINAL ",
      "keyColor": "90",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "key": "  FONT     ",
      "keyColor": "90",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "format": "{#33}▌{#0} {#1}HARDWARE{#0} {#90}{$2}"
    },
    {
      "type": "cpu",
      "key": "  CPU      ",
      "keyColor": "90",
      "format": "{name} ({cores-logical}) @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "  GPU      ",
      "keyColor": "90",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  MEMORY   ",
      "keyColor": "90",
      "format": "{used} / {total} {percentage-bar} {percentage}"
    },
    {
      "type": "disk",
      "key": "  DISK     ",
      "keyColor": "90",
      "format": "{size-used} / {size-total} {size-percentage-bar} {size-percentage}",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "  BATTERY  ",
      "keyColor": "90",
      "format": "{capacity-bar} {capacity}  {#90}{status}{#0}"
    },
    "break",
    {
      "type": "custom",
      "format": "  {#31}███{#33}███{#32}███{#36}███{#34}███{#35}███{#90}███{#0}"
    }
  ]
}
