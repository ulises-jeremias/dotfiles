// HorneroOS Signal fastfetch layout.
// Plain-text keys (no Nerd Font glyphs): mono eyebrows, one signal-amber
// tick per section, values in the default ink. Only ANSI colour names/codes
// are used, so everything follows the applied terminal palette
// (yellow = signal, 90 = muted ink, 41-47 = the palette strip).
// The logo is the hornero mark: $1 sun disc = yellow (signal), $2 bird = the default foreground (ink, readable on Day and Night).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/hornero.txt",
    "type": "file",
    "color": {
      "1": "yellow",
      "2": "39"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "",
    "constants": [
      "────────────────────────"
    ]
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}{user-name}{#0}{#90}@{#0}{#1}{host-name}{#0}"
    },
    {
      "type": "custom",
      "format": "{#33}▌{#0} {#1}SYSTEM{#0} {#90}{$1}"
    },
    {
      "type": "os",
      "key": "OS       ",
      "keyColor": "90"
    },
    {
      "type": "kernel",
      "key": "KERNEL   ",
      "keyColor": "90"
    },
    {
      "type": "packages",
      "key": "PACKAGES ",
      "keyColor": "90"
    },
    {
      "type": "shell",
      "key": "SHELL    ",
      "keyColor": "90"
    },
    {
      "type": "uptime",
      "key": "UPTIME   ",
      "keyColor": "90"
    },
    {
      "type": "custom",
      "format": "{#33}▌{#0} {#1}DESKTOP{#0} {#90}{$1}"
    },
    {
      "type": "wm",
      "key": "WM       ",
      "keyColor": "90"
    },
    {
      "type": "lm",
      "key": "SESSION  ",
      "keyColor": "90"
    },
    {
      "type": "terminal",
      "key": "TERMINAL ",
      "keyColor": "90"
    },
    {
      "type": "wmtheme",
      "key": "THEME    ",
      "keyColor": "90"
    },
    {
      "type": "wallpaper",
      "key": "WALLPAPER",
      "keyColor": "90"
    },
    {
      "type": "custom",
      "format": "{#33}▌{#0} {#1}HARDWARE{#0} {#90}{$1}"
    },
    {
      "type": "host",
      "key": "HOST     ",
      "keyColor": "90"
    },
    {
      "type": "cpu",
      "key": "CPU      ",
      "keyColor": "90"
    },
    {
      "type": "gpu",
      "key": "GPU      ",
      "keyColor": "90"
    },
    {
      "type": "memory",
      "key": "MEMORY   ",
      "keyColor": "90"
    },
    {
      "type": "disk",
      "key": "DISK     ",
      "keyColor": "90"
    },
    {
      "type": "display",
      "key": "DISPLAY  ",
      "keyColor": "90"
    },
    "break",
    {
      "type": "custom",
      "format": "{#41}  {#42}  {#43}  {#44}  {#45}  {#46}  {#47}  {#0}"
    }
  ]
}
