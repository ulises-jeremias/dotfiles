root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{qml,js}]
indent_style = space
indent_size = 4

[*.{cpp,hpp}]
indent_style = space
indent_size = 4

[*.{json,nix}]
indent_style = space
indent_size = 2

[*.{md,yaml,yml}]
trim_trailing_whitespace = false

# Compiled Qt shader blobs (e.g. assets/shaders/*.qsb) are binary: exempt
# them here because root = true above shadows the top-level exemptions.
[**.qsb]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
