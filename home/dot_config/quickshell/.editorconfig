root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{qml,js}]
indent_style = space
indent_size = 4

[*.{cpp,hpp}]
indent_style = space
indent_size = 4

[*.{json,nix}]
indent_style = space
indent_size = 2

[*.{md,yaml,yml}]
trim_trailing_whitespace = false
