pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick

// Companion frame resolver. Reads the versioned manifest generated by
// `scripts/derive-companion-assets.py` (`assets/companion/manifest.json`)
// and resolves (skin, animation) pairs to frame files with anchor,
// timing, and chaining metadata.
//
// Rules:
// - Unknown skins fall back to "default"; unknown animations to "idle".
// - Partial skins ship only grounded poses; their fly frames resolve to
//   the default Hornero fly frame via the manifest fallbackChain.
// - A missing or malformed manifest resolves to safe defaults without
//   errors (companion UI hides itself until ready).
Singleton {
    id: root

    readonly property var knownSkins: ["default", "argentina", "blue-gold", "red", "gaucho"]
    readonly property var knownAnimations: ["idle", "walk", "fly", "greet"]
    readonly property string defaultSkin: "default"
    readonly property string defaultAnimation: "idle"

    property var skins: ({})
    property var assistantStates: ({})
    property int manifestVersion: 0
    property bool ready: false

    readonly property string manifestDir: `${Quickshell.shellDir}/assets/companion`
    readonly property string manifestPath: `${root.manifestDir}/manifest.json`

    function isKnownSkin(skin: string): bool {
        return root.knownSkins.indexOf((skin ?? "").toString()) !== -1;
    }

    function isKnownAnimation(animation: string): bool {
        return root.knownAnimations.indexOf((animation ?? "").toString()) !== -1;
    }

    // Resolve (skin, animation) to display metadata. Never throws and
    // never returns an empty file: worst case is the default idle frame.
    function resolve(skin: string, animation: string): var {
        const s = root.isKnownSkin(skin) ? skin.toString() : root.defaultSkin;
        const a = root.isKnownAnimation(animation) ? animation.toString() : root.defaultAnimation;
        const entry = (root.skins[s] !== undefined && root.skins[s][a] !== undefined)
            ? root.skins[s][a]
            : null;
        if (entry === null || !Array.isArray(entry.frames) || entry.frames.length === 0) {
            return {
                "skin": root.defaultSkin,
                "animation": root.defaultAnimation,
                "file": `${root.manifestDir}/frames/default-idle.png`,
                "anchor": "feet",
                "anchorPx": [256, 472],
                "frameMs": 900,
                "loop": true,
                "next": "idle",
                "fallback": s !== root.defaultSkin
            };
        }
        const frame = entry.frames[0];
        return {
            "skin": s,
            "animation": a,
            "file": `${root.manifestDir}/${frame.file}`,
            "anchor": entry.anchor ?? "feet",
            "anchorPx": frame.anchorPx ?? [256, 472],
            "frameMs": entry.frameMs ?? 900,
            "loop": entry.loop ?? true,
            "next": entry.next ?? "idle",
            "fallback": typeof frame.file === "string" && !frame.file.startsWith(`frames/${s}-`)
        };
    }

    function frameSource(skin: string, animation: string): string {
        return root.resolve(skin, animation).file;
    }

    // Full animation reel for the player: every frame file plus timing,
    // loop, and chaining metadata. Same fallback rules as resolve(), so
    // partial skins transparently play the inlined default frames the
    // generator wrote into the manifest. Never throws and never returns
    // an empty reel: worst case is the single default idle frame.
    function reel(skin: string, animation: string): var {
        const s = root.isKnownSkin(skin) ? skin.toString() : root.defaultSkin;
        const a = root.isKnownAnimation(animation) ? animation.toString() : root.defaultAnimation;
        const entry = (root.skins[s] !== undefined && root.skins[s][a] !== undefined)
            ? root.skins[s][a]
            : null;
        const files = [];
        let frameMs = 900;
        let loop = true;
        let next = "idle";
        if (entry !== null && Array.isArray(entry.frames) && entry.frames.length > 0) {
            for (const frame of entry.frames) {
                if (frame !== null && typeof frame === "object" && typeof frame.file === "string")
                    files.push(`${root.manifestDir}/${frame.file}`);
            }
            if (typeof entry.frameMs === "number" && entry.frameMs > 0)
                frameMs = entry.frameMs;
            if (typeof entry.loop === "boolean")
                loop = entry.loop;
            if (typeof entry.next === "string")
                next = entry.next;
        }
        if (files.length === 0)
            files.push(`${root.manifestDir}/frames/default-idle.png`);
        return {
            "skin": s,
            "animation": a,
            "files": files,
            "frameMs": frameMs,
            "loop": loop,
            "next": next
        };
    }

    function stateSource(state: string): string {
        const animation = root.assistantStates[(state ?? "").toString()] ?? root.defaultAnimation;
        return root.frameSource(root.defaultSkin, animation);
    }

    // Tolerant parse mirroring the generator contract: manifestVersion
    // must be 1 with a skins object; anything else keeps safe defaults.
    function parse(text: string): void {
        const skins = {};
        const states = {};
        let version = 0;
        try {
            const o = JSON.parse(text);
            if (o !== null && typeof o === "object" && !Array.isArray(o)
                    && o.manifestVersion === 1 && o.skins !== null
                    && typeof o.skins === "object" && !Array.isArray(o.skins)) {
                for (const key of Object.keys(o.skins)) {
                    const skin = o.skins[key];
                    if (skin === null || typeof skin !== "object" || Array.isArray(skin))
                        continue;
                    if (skin.animations === null || typeof skin.animations !== "object")
                        continue;
                    skins[key] = skin.animations;
                }
                if (o.assistantStates !== null && typeof o.assistantStates === "object"
                        && !Array.isArray(o.assistantStates)) {
                    for (const key of Object.keys(o.assistantStates)) {
                        if (typeof o.assistantStates[key] === "string")
                            states[key] = o.assistantStates[key];
                    }
                }
                if (Object.keys(skins).length > 0)
                    version = 1;
            }
        } catch (e) {
            // Malformed manifest: companion stays on safe defaults.
        }
        root.skins = skins;
        root.assistantStates = states;
        root.manifestVersion = version;
        root.ready = true;
    }

    FileView {
        path: root.manifestPath
        watchChanges: true
        onFileChanged: reload()
        onLoaded: root.parse(text())
        onLoadFailed: {
            root.skins = {};
            root.assistantStates = {};
            root.manifestVersion = 0;
            root.ready = true;
        }
    }
}
